<body>
<div id="app"><div class="vazio" style="padding-top:80px">Carregando o cardápio…</div></div>
<script>
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const brl=v=>(+v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
let D=null,cat='',busca='',carro={},folha=null,fim=null,PED={tipo:'',pagamento:'',nome:'',fone:'',endereco:'',troco:'',obs:''};
try{carro=JSON.parse(localStorage.getItem('lg-cdp-carro')||'{}');Object.assign(PED,JSON.parse(localStorage.getItem('lg-cdp-dados')||'{}'));PED.tipo='';PED.pagamento=''}catch(e){}
let HIST=[];try{HIST=JSON.parse(localStorage.getItem('lg-cdp-hist'+CLI_K())||'[]')}catch(e){}
function CLI_K(){const c=new URLSearchParams(location.search).get('c');return c&&/^[a-z0-9-]{1,60}$/.test(c)?'-'+c:''}
const salvarHist=()=>{try{localStorage.setItem('lg-cdp-hist'+CLI_K(),JSON.stringify(HIST.slice(0,10)))}catch(e){}};
const salvar=()=>{try{localStorage.setItem('lg-cdp-carro',JSON.stringify(carro));localStorage.setItem('lg-cdp-dados',JSON.stringify({nome:PED.nome,fone:PED.fone,endereco:PED.endereco}))}catch(e){}};
const ORDEM=['Pratos','Porções','Oriental','Lanches','Doces','Sobremesas','Bebidas','Outros'],ICONE={Bebidas:'🥤',Pratos:'🍛','Porções':'🍟',Oriental:'🍣',Lanches:'🍔',Doces:'🍫',Sobremesas:'🍨',Outros:'🍽️'};
const ordemCat=c=>{const i=ORDEM.indexOf(c);return i<0?99:i};
function irCat(c){if(c&&!cat)try{history.pushState({cat:c},'')}catch(e){}else if(c)try{history.replaceState({cat:c},'')}catch(e){}
  cat=c;busca='';tela();window.scrollTo(0,0)}
function irMenus(){if(cat&&history.state&&history.state.cat){history.back();return}cat='';tela();window.scrollTo(0,0)}
addEventListener('popstate',()=>{if(folha&&!fim){folha=null}cat=(history.state&&history.state.cat)||'';tela()});
/* foto do menu: a primeira foto de verdade de um produto do menu; se não tiver, a ilustração */
const fotoMenu=c=>{const p=D.produtos.find(x=>x.cat===c&&x.img);return p?p.img:(D.genericas!==false?fotoGenerica('',c):'')};
const TIPOS={retirada:['Retirar no local','Busco quando ficar pronto'],local:['Comer no local','Já deixa pronto pra mim'],entrega:['Entrega','Receber em casa']};
