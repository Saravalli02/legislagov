/* “Peça de novo”: itens dos últimos pedidos deste aparelho que ainda estão no cardápio */
function pecaNovo(){const vis=new Set(),l=[];for(const h of HIST)for(const i of h.itens||[]){const p=prod(i.id);if(p&&!p.esgotado&&!vis.has(p.id)){vis.add(p.id);l.push(p)}}
