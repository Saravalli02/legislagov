  $('#fcalc').style.background=l>=0?'#eef7f1':'#fdecea'}
function salvarProduto(id){
  const nome=$('#fnome').value.trim(),preco=num($('#fpre').value);
  if(!nome)return toast('Informe o nome do produto.');if(preco<=0)return toast('Informe o preço de venda.');
  const e=$('#fest').value.trim();if(e==='')return toast('Informe a quantidade em estoque (pode ser 0).');
  const kgp=ACG&&$('#fkg')&&$('#fkg').value==='kg',old=id?S.produtos[id]:null,est=Math.max(0,kgp?Math.round(num(e)*1000)/1000:Math.round(num(e)));
  const plu=ACG?soDig(($('#fplu')||{value:''}).value):'';if(plu&&Object.values(S.produtos).some(x=>x.id!==id&&(String(+x.plu||'')===String(+plu)||(!x.plu&&String(x.codigo)===String(+plu)))))return toast('Esse código da balança já é de outro produto.');
