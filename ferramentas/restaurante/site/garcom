const $=s=>document.querySelector(s);
const brl=v=>(+v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7);
const clone=o=>JSON.parse(JSON.stringify(o??null));
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const dt=iso=>iso?new Date(iso).toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}):'—';
const hr=iso=>iso?new Date(iso).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}):'';
const num=v=>{const n=parseFloat(String(v).replace(',','.'));return isNaN(n)?0:n};
/* menus (categorias): a lista completa; cada restaurante escolhe quais usa em Ajustes › Menus (config.geral.categorias) */
/* tipo do comércio (base única): restaurante ou açougue — vem do cadastro do cliente na Central */
const ACG=!!window.LG_ACG,TIPO=ACG?'acougue':'restaurante';
const TODAS_CATS=ACG?['Bovinos','Suínos','Aves','Linguiças','Miúdos','Peixes','Temperados','Churrasco','Mercearia','Bebidas','Lanches','Doces','Outros']
  :['Bebidas','Pratos','Porções','Oriental','Lanches','Doces','Sobremesas','Outros'];
const CATS_PADRAO=ACG?['Bovinos','Suínos','Aves','Linguiças','Miúdos','Temperados','Churrasco','Mercearia','Bebidas','Outros']:['Bebidas','Pratos','Porções','Lanches','Sobremesas','Outros'];
const CATIC={Bebidas:'🥤',Pratos:'🍛',Porções:'🍟',Oriental:'🍣',Lanches:'🍔',Doces:'🍫',Sobremesas:'🍨',Outros:'🍽️',
  Bovinos:'🥩',Suínos:'🐖',Aves:'🍗',Linguiças:'🌭',Miúdos:'🍖',Peixes:'🐟',Temperados:'🧂',Churrasco:'🔥',Mercearia:'🛒'};
let CATS=CATS_PADRAO.slice();
function catsEscolhidas(){const c=(S.config||{}).categorias;return Array.isArray(c)&&c.length?TODAS_CATS.filter(x=>c.includes(x)):CATS_PADRAO}
/* as escolhidas + qualquer uma que ainda tenha produto (para nenhum produto sumir da tela) */
function atualizarCats(){const e=catsEscolhidas(),usadas=new Set(Object.values(S.produtos||{}).map(p=>p.cat));CATS=TODAS_CATS.filter(x=>e.includes(x)||usadas.has(x))}
function trocarCat(c,on){const l=catsEscolhidas().filter(x=>x!==c);if(on)l.push(c);if(!l.length)return toast('Deixe pelo menos um menu');
  mutate('config','geral',x=>({...(x||{}),categorias:TODAS_CATS.filter(y=>l.includes(y))}))}
const PAGS=ACG?[['Dinheiro','💵'],['Pix','💠'],['Débito','💳'],['Crédito','💳'],['Ticket','🎫']]:[['Pix','💠'],['Débito','💳'],['Crédito','💳']];
const PAGK=ACG?{Dinheiro:'1',Pix:'2','Débito':'3','Crédito':'4',Ticket:'5'}:{Pix:'P','Débito':'D','Crédito':'C'};
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('show');clearTimeout(t._h);t._h=setTimeout(()=>t.classList.remove('show'),2600)}
function erro(e){console.error(e);const c=e&&e.code;
  if(c==='quota_exceeded')toast('⚠️ Espaço de armazenamento cheio. Apague registros antigos.');
  else if(c==='invalid_argument')toast('⚠️ Você não tem permissão para alterar os dados.');
  else toast('⚠️ Não foi possível salvar agora. Tente de novo.');}

/* ================= dados ================= */
const S={produtos:{},mesas:{},vendas:{},movimentos:{},fila:{},estado:{},config:{}};
const SINGLE={estado:'atual',config:'geral'};
const GARCOM=location.hash==='#garcom'||/garcom/i.test(location.pathname);
let db=null,mode='loading',downloads=null,online=true;
const LS='legislagov-restaurante-v1';
const lsGet=(k,d)=>{try{const v=localStorage.getItem(k);return v==null?d:v}catch(e){return d}};
const lsSet=(k,v)=>{try{v==null?localStorage.removeItem(k):localStorage.setItem(k,v)}catch(e){}};
const DEV=lsGet('lg-dev')||(()=>{const d=uid();lsSet('lg-dev',d);return d})();
function lsSave(){if(mode!=='local')return;try{localStorage.setItem(LS,JSON.stringify(S))}catch(e){toast('⚠️ Armazenamento do aparelho cheio')}}
function lsLoad(){try{const d=JSON.parse(localStorage.getItem(LS)||'null');if(d)for(const k in S)if(d[k])S[k]=d[k]}catch(e){}}
const getDoc=(col,id)=>SINGLE[col]?S[col]:S[col][id];
function setLocal(col,id,data){if(SINGLE[col])S[col]=data||{};else if(data==null)delete S[col][id];else S[col][id]=data}
const hooks=[];let sujo=false;
function remoteApply(col,id,data){const old=getDoc(col,id);if(JSON.stringify(old??null)===JSON.stringify(data??null))return;
  setLocal(col,id,data);sujo=true;if(prontoFeito)hooks.forEach(h=>{try{h(col,id,old,data)}catch(e){console.error(e)}})}
/* --- nuvem do Claude --- */
const wq={};
function dbWrite(path,data){
  const q=wq[path]||(wq[path]={busy:false,next:undefined});
  q.next=data;if(q.busy)return;
  (async()=>{q.busy=true;
    while(q.next!==undefined){const d=q.next;q.next=undefined;
      const doIt=()=>d===null?db.doc(path).delete():db.doc(path).set(d);
      try{await doIt()}catch(e){
        if(e&&e.code==='unavailable'){await sleep(600+Math.random()*900);try{await doIt()}catch(e2){erro(e2)}}else erro(e)}}
    q.busy=false})();
}
/* --- servidor próprio (AWS) --- */
const ABORT='__ABORT__';
const B={},V={},PQ={},running={};
const kk=(col,id)=>col+'/'+(SINGLE[col]||id);
let apiKey=lsGet('lg-tok','');
async function apiFetch(path,opt={}){const r=await fetch('/api'+path,{...opt,headers:{'content-type':'application/json','x-lg-token':apiKey}});
  let body={};try{body=await r.json()}catch(e){}lgSuspenso(r.status===423);return {status:r.status,body}}
function lgSuspenso(sim){let d=document.getElementById('lgSusp');
  if(!sim){if(d)d.remove();return}
  if(d)return;d=document.createElement('div');d.id='lgSusp';
  d.innerHTML='<div class="lgs-box"><span class="hic" style="width:64px;height:64px;border-radius:18px;margin:0 auto 14px;display:grid"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span><h2 style="margin:0 0 8px">Acesso suspenso</h2><p>O acesso a este sistema está suspenso. Fale com a LegislaGov.</p><p style="font-size:.85rem">Os dados continuam guardados. Quando o acesso for liberado, esta tela some sozinha.</p></div>';
  document.body.appendChild(d)}
function setOnline(v){if(online!==v){online=v;cabecalho&&prontoFeito&&cabecalho()}}
async function apiWrite(col,id,data,ver){
  try{const r=await apiFetch('/doc/'+col+'/'+encodeURIComponent(id),{method:'PUT',body:JSON.stringify({data,ver})});setOnline(true);
    if(r.status===200)return {ok:true,ver:r.body.ver};if(r.status===409)return {conflict:true,item:r.body.item};
    if(r.status===401)pedirChave();return {}}catch(e){setOnline(false);return {}}}
function recompute(col,id){const k=kk(col,id);let d=clone(B[k]??null);for(const op of PQ[k]||[]){const r=op.fn(clone(d));if(r!==ABORT)d=r}setLocal(col,id,d)}
async function pump(col,id){const k=kk(col,id);if(running[k])return;running[k]=true;
  try{while((PQ[k]||[]).length){const op=PQ[k][0];const nd=op.fn(clone(B[k]??null));
      if(nd===ABORT){PQ[k].shift();recompute(col,id);render();op.res(false);continue}
      const r=await apiWrite(col,id,nd,V[k]||0);
      if(r.ok){B[k]=nd;V[k]=r.ver;PQ[k].shift();op.res(true)}
      else if(r.conflict){const it=r.item;B[k]=it&&!it.del?it.data:null;V[k]=it?it.ver:0}
      else await sleep(2000);
      recompute(col,id);render()}}
  finally{running[k]=false}}
function apiApply(it){const col=it.col;if(!(col in S))return;const id=SINGLE[col]?SINGLE[col]:it.id,k=kk(col,id);
  if(V[k]!=null&&it.ver<=V[k])return;V[k]=it.ver;B[k]=it.del?null:it.data;
  if((PQ[k]||[]).length){recompute(col,id);sujo=true}else remoteApply(col,id,B[k])}
let lastTs=0,syncing=false;
async function apiSync(){if(syncing||!apiKey)return;syncing=true;
  try{let since=Math.max(0,lastTs-5000),r;
    do{r=await apiFetch('/sync?since='+since);
      if(r.status===401){pedirChave();return}if(r.status!==200)throw 0;
      if(r.body.tipo&&r.body.tipo!==TIPO){lsSet('lg-tipo',r.body.tipo);location.reload();return}
      for(const it of r.body.items){apiApply(it);if(it.ts>lastTs)lastTs=it.ts}
      since=lastTs-1}while(r.body.more);
    setOnline(true);
    if(!prontoFeito)pronto();else if(sujo){sujo=false;render()}}
  catch(e){setOnline(false)}finally{syncing=false}}
function pedirChave(){if($('#lgLogin'))return;$('#loading').classList.add('hidden');fecharModal();
  const d=document.createElement('div');d.id='lgLogin';
  d.innerHTML=`<div class="lgl-in"><div class="lgl-cab"><div class="lgent-logo">${LOGO_X()}</div><h2>Entrar</h2><p>Use o usuário e a senha que você recebeu.</p></div>
  <form class="lgl-card" id="lgForm"><label for="lgu">Usuário</label><input id="lgu" autocomplete="username" autocapitalize="none" spellcheck="false">
  <label for="lgs">Senha</label><input id="lgs" type="password" autocomplete="current-password">
  <button class="lgl-bt" id="lgb" type="submit">Entrar</button><p id="lge" class="lgl-erro" role="alert"></p></form>
  <div class="lgl-card lgl-app"><div class="lgl-ic">${LOGO_X()}</div><div style="flex:1"><b>Baixe o app no celular</b><small>Abre direto pela tela inicial, como os outros apps.</small></div><button class="lgl-bx" id="lgApp" type="button">Baixar</button></div>
  <p class="lgl-rod">LegislaGov ${ACG?'Açougue':'Restaurante'} · ${GARCOM?'App do garçom':'Caixa'}</p></div>`;
  document.body.appendChild(d);
  $('#lgForm').onsubmit=e=>{e.preventDefault();entrarRest()};$('#lgApp').onclick=baixarApp;setTimeout(()=>$('#lgu').focus(),60)}
let instalar=null;addEventListener('beforeinstallprompt',e=>{e.preventDefault();instalar=e});
function baixarApp(){if(instalar){instalar.prompt();instalar=null;return}
  const ios=/iphone|ipad|ipod/i.test(navigator.userAgent);
  abrirModal(`<h2>Instalar no celular</h2><p>${ios?'No Safari, toque em <b>Compartilhar</b> (o quadrado com a seta) e depois em <b>Adicionar à Tela de Início</b>.':'No Chrome, toque nos <b>três pontinhos</b> e depois em <b>Instalar app</b> ou <b>Adicionar à tela inicial</b>.'}</p><button class="btn pri big" onclick="fecharModal()" style="width:100%">Entendi</button>`)}
async function entrarRest(){const b=$('#lgb'),u=$('#lgu').value.trim(),sn=$('#lgs').value;$('#lge').textContent='';
  if(!u||!sn){$('#lge').textContent='Digite o usuário e a senha.';return}b.disabled=true;
  try{const r=await fetch('/api/entrar',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({usuario:u,senha:sn,tipo:TIPO})});
    const d=await r.json().catch(()=>({}));
    if(r.ok&&d.token){apiKey=d.token;lsSet('lg-tok',apiKey);lsSet('lg-nome',d.nome||'');const t=d.tipo==='acougue'?'acougue':'restaurante';lsSet('lg-tipo',t);
      if(t!==TIPO){location.reload();return}$('#lgLogin').remove();apiSync();return}
    $('#lge').textContent=d.erro||'Não foi possível entrar.';$('#lgs').value='';$('#lgs').focus()}catch(e){$('#lge').textContent='Sem internet. Tente de novo quando conectar.'}
  b.disabled=false}
function sairRest(){fetch('/api/sair',{method:'POST',headers:{'x-lg-token':apiKey}}).catch(()=>{});apiKey='';lsSet('lg-tok','');lsSet('lg-tipo','');location.reload()}
/* --- gravação única para os 3 modos --- */
function mutate(col,id,fn){
  if(SINGLE[col])id=SINGLE[col];
  if(mode!=='api'){const nd=fn(clone(getDoc(col,id)??null));if(nd===ABORT)return Promise.resolve(false);
    setLocal(col,id,nd);render();if(mode==='db')dbWrite(col+'/'+id,nd);else lsSave();return Promise.resolve(true)}
  return new Promise(res=>{const k=kk(col,id);(PQ[k]=PQ[k]||[]).push({fn,res});recompute(col,id);render();pump(col,id)})}
const put=(col,id,data)=>mutate(col,id,()=>data);
const del=(col,id)=>put(col,id,null);

async function iniciar(){
  try{
    if(window.claude&&window.claude.use){
      let timer=setTimeout(()=>{if(mode==='loading')modoLocal()},10000);
      const d=await window.claude.use('db');clearTimeout(timer);
      claude.use('downloads').then(x=>{downloads=x;render()}).catch(()=>{});
      if(d){db=d;mode='db';assinar();return}
      return modoLocal();
    }
    if(/^https?:$/.test(location.protocol)){
      const r=await fetch('/api/ping').catch(()=>null);
      if(r&&r.ok){mode='api';
        const L=(rel,href)=>{const l=document.createElement('link');l.rel=rel;l.href=href;document.head.appendChild(l)};
        L('manifest',ACG?'/manifest-acougue.json':GARCOM?'/manifest-garcom.json':'/manifest.json');L('apple-touch-icon',ACG?'https://central.legislagov.com.br/restaurante/acougue-180.png':'/apple-touch-icon.png');
        const M=document.createElement('meta');M.name='apple-mobile-web-app-capable';M.content='yes';document.head.appendChild(M);
        if(!apiKey){$('#loading').classList.add('hidden');pedirChave()}
        await apiSync();setInterval(apiSync,GARCOM?2500:2000);
        document.addEventListener('visibilitychange',()=>{if(!document.hidden)apiSync()});
        if('serviceWorker' in navigator)navigator.serviceWorker.register('/sw.js').catch(()=>{});
        return}
    }
  }catch(e){console.error(e)}
  modoLocal();
}
function modoLocal(){if(mode!=='loading')return;mode='local';lsLoad();pronto()}
let carregados=new Set(),prontoFeito=false;
function pronto(){if(prontoFeito)return;prontoFeito=true;setTimeout(migrarCodigos,2500);$('#loading').classList.add('hidden');hooks.forEach(h=>{try{h('*')}catch(e){}});render(true)}
function assinar(){
  const need=['produtos','mesas','movimentos','vendas','fila','estado','config'];
  const ok=c=>{carregados.add(c);if(need.every(n=>carregados.has(n)))pronto()};
  setTimeout(()=>{if(!prontoFeito){pronto();toast('⚠️ Sem conexão com os dados ainda — aguarde.')}},10000);
  const busy=p=>(wq[p]||{}).busy;
  const colSub=(col,q)=>q.onSnapshot(snap=>{
    const vistos=new Set();
    snap.docs.forEach(d=>{vistos.add(d.id);if(!busy(col+'/'+d.id))remoteApply(col,d.id,d.data())});
    if(!snap.metadata.fromCache&&col!=='vendas')for(const id in S[col])if(!vistos.has(id)&&!busy(col+'/'+id))remoteApply(col,id,null);
    if(!snap.metadata.fromCache)ok(col);if(sujo){sujo=false;render()}
  },e=>{erro(e);ok(col)});
  colSub('produtos',db.collection('produtos'));
  colSub('mesas',db.collection('mesas'));
  colSub('movimentos',db.collection('movimentos'));
  colSub('fila',db.collection('fila'));
  colSub('vendas',db.collection('vendas').orderBy('data','desc').limit(1000));
  for(const c of ['estado','config'])db.doc(c+'/'+SINGLE[c]).onSnapshot(d=>{
    if(!busy(c+'/'+SINGLE[c]))remoteApply(c,SINGLE[c],d.exists?d.data():{});
    if(!d.metadata.fromCache)ok(c);if(sujo){sujo=false;render()}
  },e=>{erro(e);ok(c)});
}

/* ================= regras de negócio ================= */
const movAtual=()=>S.estado&&S.estado.movId?S.movimentos[S.estado.movId]:null;
const movAberto=()=>{const m=movAtual();return m&&!m.fechamento};
const mesa=n=>S.mesas[String(n)]||{itens:[]};

const vIt=i=>i.tot!=null?+i.tot:Math.round((+i.preco||0)*(+i.qtd||0)*100)/100;
const fq=i=>i.un==='kg'?(+i.qtd||0).toLocaleString('pt-BR',{minimumFractionDigits:3,maximumFractionDigits:3})+' kg':i.qtd+'x';
const totItens=its=>(its||[]).reduce((s,i)=>s+vIt(i),0);
const custoItens=its=>(its||[]).reduce((s,i)=>s+(i.custo||0)*i.qtd,0);
const totMesa=n=>totItens(mesa(n).itens);
function reservado(pid){let r=0;for(const k in S.mesas)(S.mesas[k].itens||[]).forEach(i=>{if(i.pid===pid)r+=i.qtd});return r}
function disponivel(p){if(p.estoque===''||p.estoque==null)return Infinity;return p.estoque-reservado(p.id)}
const prodList=()=>Object.values(S.produtos).sort((a,b)=>a.nome.localeCompare(b.nome,'pt-BR'));
const controla=p=>!(p.estoque===''||p.estoque==null);
const estMin=p=>p.estoqueMin===''||p.estoqueMin==null?3:+p.estoqueMin;
function nivel(p){if(!controla(p))return 'ok';const d=disponivel(p);return d<=0?'esg':d<=estMin(p)?'baixo':'ok'}
const nomeP=p=>p.nome+(p.unidade?' '+p.unidade:'');
const avisos=()=>prodList().filter(p=>nivel(p)!=='ok').sort((a,b)=>disponivel(a)-disponivel(b));
