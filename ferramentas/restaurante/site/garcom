/* ---------- RELATÓRIOS ---------- */
function vRelatorios(){
  const movs=Object.values(S.movimentos).sort((a,b)=>b.abertura.localeCompare(a.abertura));
  if(!movs.length)return `<h2>📊 Relatórios</h2><div class="card vazio">Nenhum movimento ainda. Abra o primeiro em 🔐 Movimento.</div>`;
  const id=st.relMov&&S.movimentos[st.relMov]?st.relMov:movs[0].id,m=S.movimentos[id];
  return `<div class="row" style="margin-bottom:12px"><h2 style="margin:0;flex:1">📊 Relatório do dia</h2>
  <select style="width:auto" onchange="st.relMov=this.value;render(true)">${movs.map(x=>`<option value="${x.id}" ${x.id===id?'selected':''}>${dt(x.abertura).slice(0,10)} ${x.fechamento?'':'(aberto)'}</option>`).join('')}</select>
  <button class="btn pri" onclick="imprimir(relHtml('${id}'),'relatorio-${dt(m.abertura).slice(0,10).replace(/\//g,'-')}')">🖨️ Imprimir</button></div>${relHtml(id,true)}`;
}
function relHtml(id,tela){
  const m=S.movimentos[id],vs=Object.values(S.vendas).filter(v=>v.movId===id);
  const tot=vs.reduce((s,v)=>s+v.total,0),cus=vs.reduce((s,v)=>s+(v.custo||0),0),luc=tot-cus;
  const pag={};PAGS.forEach(([p])=>pag[p]={n:0,v:0});vs.forEach(v=>{(pag[v.pagamento]||(pag[v.pagamento]={n:0,v:0})).n++;pag[v.pagamento].v+=v.total});
  const pr={};vs.forEach(v=>v.itens.forEach(i=>{const k=i.nome;const o=pr[k]||(pr[k]={q:0,v:0,c:0});o.q+=i.qtd;o.v+=i.preco*i.qtd;o.c+=(i.custo||0)*i.qtd}));
  const prs=Object.entries(pr).sort((a,b)=>b[1].v-a[1].v);
  const cab=`<div><b>Abertura:</b> ${dt(m.abertura)}<br><b>Fechamento:</b> ${m.fechamento?dt(m.fechamento):'em aberto'}</div>`;
  const resumo=`<table><tr><td>Vendas (mesas fechadas)</td><td class="n">${vs.length}</td></tr><tr><td>Ticket médio</td><td class="n">${brl(vs.length?tot/vs.length:0)}</td></tr>
  <tr><td><b>Total vendido</b></td><td class="n"><b>${brl(tot)}</b></td></tr><tr><td>Custo dos produtos</td><td class="n">${brl(cus)}</td></tr><tr><td><b>Lucro real</b></td><td class="n"><b>${brl(luc)}</b></td></tr></table>`;
  const tpag=`<table><tr><th>Pagamento</th><th class="n">Qtd</th><th class="n">Valor</th></tr>${Object.entries(pag).map(([p,o])=>`<tr><td>${esc(p)}</td><td class="n">${o.n}</td><td class="n">${brl(o.v)}</td></tr>`).join('')}</table>`;
  const tpr=prs.length?`<table><tr><th>Produto</th><th class="n">Qtd</th><th class="n">Vendido</th><th class="n">Lucro</th></tr>${prs.map(([n,o])=>`<tr><td>${esc(n)}</td><td class="n">${o.q}</td><td class="n">${brl(o.v)}</td><td class="n">${brl(o.v-o.c)}</td></tr>`).join('')}</table>`:'<div class="vazio">Nenhum produto vendido.</div>';
  if(!tela)return `<div class="cupom">${cupomCab()}<div class="c">RELATÓRIO DO MOVIMENTO</div><hr>${cab}<hr>${resumo}<hr><b>Por forma de pagamento</b>${tpag}<hr><b>Produtos vendidos</b>${tpr}</div>`;
  return `<div class="stats"><div class="stat"><small>Total vendido</small><b>${brl(tot)}</b></div><div class="stat"><small>Custo</small><b>${brl(cus)}</b></div>
  <div class="stat"><small>Lucro real</small><b class="${luc>=0?'lucro':'prej'}">${brl(luc)}</b></div><div class="stat"><small>Vendas</small><b>${vs.length}</b></div></div>
  <div class="caixa"><div class="card"><h3>🗓️ Movimento</h3>${cab}<br>${resumo}<br><h3>💳 Por forma de pagamento</h3>${tpag}</div>
  <div class="card"><h3>🥤 Produtos vendidos</h3>${tpr}</div></div>`;
}

