  <table><tr><th>Produto</th><th class="n">Vend.</th><th class="n">Restou</th></tr>
  ${linhas.map(l=>`<tr><td>${esc(nomeP(l.p))}${l.p.codigo?' <small>#'+l.p.codigo+'</small>':''}<br><small>início ${l.inicio}${l.ent?' · entrada +'+l.ent:''}${l.aj?' · ajuste '+(l.aj>0?'+':'')+l.aj:''}</small></td><td class="n">${l.vd}</td><td class="n"><b>${l.restou}</b>${l.restou<=0?'<br><small>ESGOTADO</small>':l.restou<=(+l.p.estoqueMin||0)?'<br><small>ACABANDO</small>':''}</td></tr>`).join('')||'<tr><td colspan="3">Nenhum produto com controle de estoque.</td></tr>'}</table>
  ${sem.length?`<hr><div class="c">SEM CONTROLE DE ESTOQUE (VENDIDOS)</div><table>${sem.map(x=>`<tr><td>${esc(nomeP(x.p))}</td><td class="n">${x.vd}</td></tr>`).join('')}</table>`:''}
  <hr><table><tr><td>Itens vendidos</td><td class="n"><b>${Object.values(vend).reduce((a,b)=>a+b,0)}</b></td></tr><tr><td>Esgotados</td><td class="n">${acab}</td></tr><tr><td>Acabando</td><td class="n">${baixo}</td></tr></table>
  <hr><div class="c">Impresso em ${dt(new Date().toISOString())}</div></div>`}
