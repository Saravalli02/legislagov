<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#2a1517">
<link rel="icon" href="https://central.legislagov.com.br/restaurante/icon-192.png">
<link rel="apple-touch-icon" href="https://central.legislagov.com.br/restaurante/apple-touch-icon.png">
<title>LegislaGov Restaurante</title>
<style>
:root{--pri:#0f3d5e;--pri2:#16557f;--acc:#f28c28;--ok:#1f8a4c;--bad:#c0392b;--bg:#f4f1ea;--card:#fff;--txt:#1d2733;--mut:#6b7684;--line:#e3ddd1;--r:14px}
*{box-sizing:border-box}
body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--txt);font-size:16px}
button{font:inherit;cursor:pointer;border:0;border-radius:10px}
input,select{font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:10px;width:100%;background:#fff}
label{display:block;font-size:.85rem;color:var(--mut);margin:10px 0 4px;font-weight:600}
.hidden{display:none!important}
header{background:var(--pri);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:12px;cursor:pointer}
.logo{width:52px;height:52px;border-radius:12px;background:#d32f2f;box-shadow:0 0 0 3px #ffffff33;display:grid;place-items:center;font-size:30px;overflow:hidden;flex:none}
.logo img{width:100%;height:100%;object-fit:contain;background:#fff}
.logo.red{background:#d32f2f}
.brand b{color:#fff}.brand span{color:#ff8a80!important}
.mico{width:46px;height:32px;display:block}
.mesa .ic{color:#8a6a4a}.mesa.ocupada .ic{color:#d32f2f}
nav .mico{width:34px;height:26px}
.brand b{display:block;font-size:1.35rem;letter-spacing:.3px}
.brand span{font-size:.85rem;color:#ffd7ad;text-transform:uppercase;letter-spacing:2px}
.pill{padding:8px 14px;border-radius:999px;font-size:.85rem;font-weight:600;background:#ffffff22;display:flex;align-items:center;gap:8px}
.pill.on{background:#1f8a4c}.pill.off{background:#c0392b}
.save{font-size:.75rem;opacity:.85;margin-left:4px}
nav{background:var(--pri2);display:flex;gap:6px;padding:8px;overflow-x:auto;position:sticky;top:0;z-index:5}
nav button{background:transparent;color:#fff;display:flex;flex-direction:column;align-items:center;gap:2px;padding:8px 14px;min-width:92px;font-size:.85rem;font-weight:600}
nav button i{font-style:normal;font-size:1.7rem;line-height:1}
nav button.act{background:#fff;color:var(--pri)}
main{max-width:1200px;margin:0 auto;padding:16px}
h2{margin:4px 0 14px;font-size:1.35rem}
h3{margin:0 0 10px;font-size:1.05rem}
.card{background:var(--card);border-radius:var(--r);padding:16px;box-shadow:0 1px 3px #0001}
.aviso{background:#fff4e5;border:1px solid #f5c58a;padding:12px 14px;border-radius:12px;margin-bottom:14px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.btn{padding:11px 16px;font-weight:700;background:#e9e4da;color:var(--txt)}
.btn.pri{background:var(--pri);color:#fff}.btn.acc{background:var(--acc);color:#fff}.btn.ok{background:var(--ok);color:#fff}.btn.bad{background:var(--bad);color:#fff}
.btn.big{padding:16px 22px;font-size:1.1rem;width:100%}
.btn:disabled{opacity:.45;cursor:not-allowed}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:14px}
.stat{background:#fff;border-radius:12px;padding:12px 14px;box-shadow:0 1px 3px #0001}
.stat small{color:var(--mut);font-weight:600;display:block}.stat b{font-size:1.3rem}
.mesas{display:grid;grid-template-columns:repeat(auto-fill,minmax(108px,1fr));gap:10px}
.mesa{background:#fff;border:2px solid var(--line);padding:12px 6px;display:flex;flex-direction:column;align-items:center;gap:2px;min-height:110px;justify-content:center;transition:transform .08s}
.mesa:active{transform:scale(.97)}
.mesa .ic{font-size:1.4rem}.mesa b{font-size:1.7rem;color:var(--pri)}
.mesa .mv{font-size:.85rem;color:var(--mut);font-weight:600}
.mesa.ocupada{background:#fff3e6;border-color:var(--acc)}
.mesa.ocupada .mv{color:#b35a00;font-size:.95rem}
.caixa{display:grid;grid-template-columns:1fr 1.2fr;gap:14px}.caixa>*{min-width:0}
@media(max-width:860px){.caixa{grid-template-columns:1fr}}
.it{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}
.thumb{width:44px;height:44px;border-radius:8px;background:#f0ece4;display:grid;place-items:center;font-size:1.4rem;overflow:hidden;flex:none}
.thumb img{width:100%;height:100%;object-fit:cover}
.it .nm{flex:1;min-width:0}.it .nm b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.it .nm small{color:var(--mut)}
.qty{display:flex;align-items:center;gap:4px}
.qty button{width:34px;height:34px;background:#eee8dd;font-weight:800;font-size:1.1rem}
.qty span{min-width:26px;text-align:center;font-weight:700}
.sub{min-width:84px;text-align:right;font-weight:700}
.total{display:flex;justify-content:space-between;align-items:center;font-size:1.5rem;font-weight:800;padding:14px 0}
.vazio{color:var(--mut);text-align:center;padding:24px 8px}
.chips{display:flex;gap:6px;overflow-x:auto;margin:10px 0}
.chip{background:#eee8dd;padding:7px 12px;border-radius:999px;font-size:.85rem;font-weight:600;white-space:nowrap}
.chip.act{background:var(--pri);color:#fff}
.prods{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;max-height:560px;overflow:auto;padding:2px}
.prod{background:#faf8f4;border:1px solid var(--line);padding:8px;display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center}
.prod .pi{width:100%;aspect-ratio:1;border-radius:8px;background:#f0ece4;display:grid;place-items:center;font-size:2.2rem;overflow:hidden}
.prod .pi img{width:100%;height:100%;object-fit:cover}
.prod b{font-size:.9rem;line-height:1.15}.prod small{color:var(--mut);font-size:.75rem}
.prod .pr{color:var(--ok);font-weight:800}
.prod.esg{opacity:.45}
.plist{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
.pcard{background:#fff;border-radius:12px;padding:12px;display:flex;gap:12px;box-shadow:0 1px 3px #0001}
.pcard .thumb{width:72px;height:72px;font-size:2rem}
.pcard .info{flex:1;min-width:0;font-size:.9rem}
.pcard .info b{font-size:1rem;display:block}
.lucro{color:var(--ok);font-weight:700}.prej{color:var(--bad);font-weight:700}
.tag{display:inline-block;background:#eee8dd;border-radius:6px;padding:1px 7px;font-size:.75rem;font-weight:600;margin-right:4px}
table{width:100%;border-collapse:collapse;font-size:.92rem}
th,td{padding:8px 6px;border-bottom:1px solid var(--line);text-align:left}
th{color:var(--mut);font-size:.8rem;text-transform:uppercase}
td.n,th.n{text-align:right}
.hist{display:flex;flex-direction:column;gap:8px}
.hrow{background:#fff;border-radius:12px;padding:12px 14px;box-shadow:0 1px 3px #0001}
.hrow .top{display:flex;justify-content:space-between;gap:10px;align-items:center;cursor:pointer}
.hrow .det{margin-top:10px}
.movbox{max-width:560px;margin:0 auto;text-align:center}
.movbox .ic{font-size:4rem}
#modalBg{position:fixed;inset:0;background:#0008;z-index:50;display:flex;align-items:center;justify-content:center;padding:12px}
#modal{background:#fff;border-radius:16px;padding:20px;width:100%;max-width:520px;max-height:92vh;overflow:auto}
.pags{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:12px 0 16px}
.pags button{background:#f0ece4;padding:18px 6px;font-weight:800;display:flex;flex-direction:column;align-items:center;gap:6px;border:3px solid transparent}
.pags button i{font-style:normal;font-size:2rem}
.pags button.act{border-color:var(--pri);background:#e3eef7}
.totalBig{font-size:2.3rem;font-weight:900;text-align:center;color:var(--pri);margin:6px 0}
.cupom{font-family:"Courier New",monospace;background:#fffef8;border:1px dashed #bbb;padding:14px;font-size:.85rem;white-space:normal}
.cupom h4{text-align:center;margin:0 0 4px}.cupom .c{text-align:center}
.cupom table td,.cupom table th{padding:3px 2px;border:0;font-size:.82rem}
.cupom hr{border:0;border-top:1px dashed #999}
.imgprev{width:110px;height:110px;border-radius:12px;background:#f0ece4;display:grid;place-items:center;font-size:2.6rem;overflow:hidden;border:2px dashed var(--line);cursor:pointer}
.imgprev img{width:100%;height:100%;object-fit:cover}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}
.calc{background:#eef7f1;border-radius:10px;padding:10px 12px;margin-top:12px;font-weight:600}
#toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:#1d2733;color:#fff;padding:12px 18px;border-radius:12px;font-weight:600;z-index:60;opacity:0;pointer-events:none;transition:opacity .2s;max-width:92vw;text-align:center}
#toast.show{opacity:1}
#loading{position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;z-index:70;font-weight:600;color:var(--mut)}
#printArea{display:none}

.tabs{display:flex;background:#e9e4da;border-radius:12px;padding:4px;gap:4px}
.tabs button{background:transparent;padding:9px 14px;font-weight:700;display:flex;align-items:center;gap:6px}
.tabs button .mico{width:30px;height:22px}
.tabs button.act{background:#fff;box-shadow:0 1px 3px #0002}
.cnt{background:#e53935;color:#fff;border-radius:10px;padding:0 7px;font-size:.78rem}
.mesa{position:relative}
.mesa.conta{border-color:#e53935;animation:pisca 1.4s ease-in-out infinite}
@keyframes pisca{50%{box-shadow:0 0 0 4px #e5393555}}
.mesa .flag{position:absolute;top:4px;left:4px;right:4px;background:#e53935;color:#fff;font-size:.68rem;font-weight:800;border-radius:6px;padding:1px 0}
.gnm{font-size:.72rem;color:var(--mut)}
.pedlog{background:#f7f4ee;border-radius:8px;padding:7px 10px;margin:6px 0;font-size:.88rem}
.cfg{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px;align-items:start}
.chk{display:flex!important;gap:10px;align-items:flex-start;color:var(--txt)!important;font-weight:500!important;font-size:.95rem!important;cursor:pointer;margin:10px 0!important}
.chk input{width:22px;height:22px;flex:none;margin-top:1px}
/* app do garçom */
body.gmode header,body.gmode nav,body.gmode #atalhos{display:none!important}
body.gmode{padding-bottom:90px;background:#f4f1ea}
body.gmode main{padding:0;max-width:640px}
.gtop{background:var(--pri);color:#fff;display:flex;align-items:center;gap:10px;padding:10px 12px;position:sticky;top:0;z-index:6;padding-top:max(10px,env(safe-area-inset-top))}
.gtop small{color:#ffd7ad}
.gbtn{background:#ffffff22;color:inherit;padding:9px 12px;font-weight:700}
.gbar{display:flex;align-items:center;gap:10px;padding:10px 12px;background:#fff;border-bottom:1px solid var(--line);position:sticky;top:58px;z-index:5}
.gbar .gbtn{background:#eee8dd;color:var(--txt)}
.gbar span{text-align:right;line-height:1.1}.gbar small{color:var(--mut);font-size:.72rem}
.gtabs{display:flex;background:#fff;border-bottom:1px solid var(--line)}
.gtabs button{flex:1;background:transparent;padding:14px 6px;font-weight:800;border-radius:0;border-bottom:4px solid transparent;color:var(--mut)}
.gtabs button.act{border-bottom-color:#d32f2f;color:var(--txt)}
.gpad{padding:12px}
.gmesas{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.gmesas button{background:#fff;border:2px solid var(--line);padding:10px 4px;display:flex;flex-direction:column;align-items:center;min-height:104px;justify-content:center;position:relative}
.gmesas button .ic{color:#8a6a4a}.gmesas button b{font-size:1.6rem;color:var(--pri);line-height:1}
.gmesas button small{color:var(--mut);font-weight:700}
.gmesas button.ocupada{background:#fff3e6;border-color:var(--acc)}.gmesas button.ocupada .ic{color:#d32f2f}
.gmesas button.conta{border-color:#e53935}
.gmesas em{font-style:normal;font-size:.72rem;font-weight:800;color:#c0392b}
.gcats{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.gcats button{background:#fff;padding:20px 8px;display:flex;flex-direction:column;align-items:center;gap:4px;font-weight:800;font-size:1.05rem;box-shadow:0 1px 3px #0001}
.gcats i{font-style:normal;font-size:2.6rem}.gcats small{color:var(--mut);font-weight:600;font-size:.78rem}
.gchips{display:flex;gap:6px;overflow-x:auto;padding:10px 12px;background:#f4f1ea;position:sticky;top:116px;z-index:4}
.gchips button{background:#fff;padding:9px 13px;border-radius:999px;font-weight:700;white-space:nowrap;box-shadow:0 1px 2px #0001}
.gchips button.act{background:var(--pri);color:#fff}
.gchips button:first-child{background:#d32f2f;color:#fff}
.gprod{background:#fff;border-radius:12px;padding:10px;display:flex;gap:10px;align-items:center;margin-bottom:8px;box-shadow:0 1px 2px #0001}
.gprod.esg{opacity:.5}
.gprod .thumb{width:58px;height:58px;font-size:1.9rem}
.gprod .nm{flex:1;min-width:0;display:flex;flex-direction:column}.gprod .nm small{color:var(--mut)}.gprod .pr{color:var(--ok);font-weight:800}
.gqty{display:flex;align-items:center;gap:6px}
.gqty button{width:42px;height:42px;border-radius:50%;background:#eee8dd;font-size:1.4rem;font-weight:800}
.gqty button.mais{background:var(--ok);color:#fff}
.gqty span{min-width:22px;text-align:center;font-weight:800;font-size:1.15rem}
.gcart{position:fixed;left:10px;right:10px;bottom:max(10px,env(safe-area-inset-bottom));max-width:620px;margin:auto;background:#d32f2f;color:#fff;border-radius:14px;padding:16px 18px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 6px 20px #0004;z-index:7;cursor:pointer}
.glogin{padding:28px 18px;max-width:420px;margin:auto}
.gnomes{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.gnomes button{background:#fff;padding:18px 8px;font-weight:800;font-size:1.05rem;box-shadow:0 1px 3px #0001}
.pindots{display:flex;justify-content:center;gap:14px;margin:8px 0 18px}
.pindots span{width:18px;height:18px;border-radius:50%;border:2px solid var(--pri)}.pindots span.on{background:var(--pri)}
.pinpad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.pinpad button{background:#fff;padding:18px 0;font-size:1.5rem;font-weight:800;box-shadow:0 1px 3px #0001}
.hdr-r{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.sino{position:relative;background:#ffffff22;color:#fff;font-size:1.5rem;width:46px;height:46px;border-radius:50%}
.sino.tem{animation:bal 1.6s ease-in-out infinite}
@keyframes bal{0%,80%,100%{transform:rotate(0)}85%{transform:rotate(14deg)}90%{transform:rotate(-12deg)}95%{transform:rotate(8deg)}}
.badge{position:absolute;top:-3px;right:-3px;background:#e53935;color:#fff;font-size:.72rem;font-weight:800;min-width:20px;height:20px;border-radius:10px;display:grid;place-items:center;padding:0 5px;border:2px solid var(--pri)}
nav button small{font-size:.65rem;opacity:.7;font-weight:700}
#atalhos{position:fixed;bottom:0;left:0;right:0;background:#1d2733;color:#cfd6de;font-size:.8rem;padding:7px 12px;text-align:center;z-index:4}
#atalhos kbd{background:#3a4654;color:#fff;border-radius:5px;padding:1px 6px;font-family:inherit;font-weight:700}
body{padding-bottom:40px}
@media(max-width:760px),(pointer:coarse){#atalhos{display:none}body{padding-bottom:0}}
kbd.k{background:#00000022;border-radius:5px;padding:0 5px;font-family:inherit;font-size:.75em;margin-left:4px}
#alerta{position:fixed;top:12px;left:50%;transform:translateX(-50%);z-index:65;background:#fff;border-left:8px solid #e53935;box-shadow:0 8px 30px #0004;border-radius:12px;padding:14px 18px;max-width:94vw;width:460px;cursor:pointer;animation:cai .25s ease-out}
@keyframes cai{from{transform:translate(-50%,-30px);opacity:0}}
#alerta h4{margin:0 0 6px;color:#c0392b;font-size:1.05rem}
#alerta div{padding:3px 0;font-weight:600}
.st-esg{color:#c0392b;font-weight:800}.st-baixo{color:#d35400;font-weight:800}.st-ok{color:var(--ok);font-weight:800}
.erow{background:#fff;border-radius:12px;padding:12px;display:grid;grid-template-columns:56px 1fr auto;gap:12px;align-items:center;box-shadow:0 1px 3px #0001;border-left:6px solid var(--ok)}
.erow.baixo{border-left-color:#e67e22}.erow.esg{border-left-color:#e53935;background:#fff6f5}
.erow .thumb{width:56px;height:56px;font-size:1.8rem}
.enum{text-align:center;min-width:86px}.enum b{font-size:1.8rem;display:block;line-height:1}.enum small{color:var(--mut);font-size:.75rem}
.eacts{grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap}
.quick{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}.quick button{background:#eee8dd;padding:10px 14px;font-weight:800}
.prod .low{color:#d35400;font-weight:800}

/* ===== refino visual LegislaGov ===== */
:root{--pri:#2a1517;--pri2:#3a1d20;--acc:#d32f2f;--bg:#f6f3ef;--line:#e6dfd6;--vinho:#7a1c1f;--r:16px}
body{font-family:"Segoe UI",system-ui,-apple-system,Roboto,sans-serif;-webkit-font-smoothing:antialiased}
header{background:var(--pri);padding:12px 20px;border-bottom:1px solid #ffffff14}
.logo{background:transparent!important;box-shadow:0 0 0 1px #ffffff26,0 4px 14px #0005;border-radius:14px}
.logo img.lg-pilar{width:100%;height:100%;object-fit:cover;background:none!important}
#loading .logo,.glogin .logo,.imgprev .logo{box-shadow:0 10px 30px #3a141833}
.brand b{font-weight:700;letter-spacing:.2px}.brand span{color:#ff8f8a!important;font-weight:600;letter-spacing:3px;font-size:.78rem}
.sino{width:44px;height:44px;border-radius:12px;background:#ffffff10;border:1px solid #ffffff2e;display:grid;place-items:center;padding:0}
.sino .nico{width:22px;height:22px}.sino:hover{background:#ffffff1f}
.badge{border-color:var(--pri)}
.pill{border:1px solid #ffffff2e;background:#ffffff10}
.pill.on{background:#1f8a4c33;border-color:#3ecf7a66}.pill.off{background:#d32f2f33;border-color:#ff6b6b66}
nav{background:var(--pri2);padding:10px 14px;gap:6px;border-bottom:1px solid #00000033;box-shadow:0 6px 18px #2a151722}
nav button{min-width:96px;padding:8px 10px 7px;border-radius:14px;gap:5px;color:#f3e9e9;font-weight:600;letter-spacing:.1px;transition:background .15s}
nav button i{width:42px;height:42px;border-radius:12px;border:1px solid #ffffff38;background:#ffffff0d;display:grid;place-items:center;font-size:1.35rem}
nav button .nico{width:22px;height:22px}nav button .mico{width:28px;height:20px}
nav button:hover{background:#ffffff12}
nav button.act{background:#fff;color:var(--pri)}
nav button.act i{background:#fdecea;border-color:#f3b8b4;color:var(--acc)}
nav button small{opacity:.6}
main{padding:20px 18px}
h2{font-weight:700;letter-spacing:-.2px}
main>h2,.row>h2{display:flex;align-items:center;gap:10px}
.card,.stat,.hrow,.pcard,.gprod,.gcats button,.gnomes button,.pinpad button,.erow{box-shadow:none;border:1px solid var(--line)}
.card{border-radius:var(--r)}
.stats{gap:12px}
.stat{border-radius:14px;padding:14px 16px 14px 18px;position:relative;overflow:hidden}
.stat::before{content:"";position:absolute;left:0;top:12px;bottom:12px;width:4px;border-radius:0 4px 4px 0;background:var(--acc)}
.stat:nth-child(2)::before{background:#e8913a}.stat:nth-child(3)::before{background:#1f8a4c}
.stat b{font-size:1.45rem;letter-spacing:-.3px}
.mesas{gap:12px;grid-template-columns:repeat(auto-fill,minmax(112px,1fr))}
.mesa{border:1px solid var(--line);border-radius:16px;min-height:124px;gap:6px;background:#fff;transition:transform .08s,border-color .15s,box-shadow .15s}
.mesa:hover{border-color:#d9c9bb;box-shadow:0 6px 16px #2a151712}
.mesa .ic{width:46px;height:38px;border-radius:11px;border:1px solid var(--line);background:#faf7f3;display:grid;place-items:center}
.mesa .ic .mico{width:30px;height:21px}
.mesa b{color:var(--pri);font-size:1.6rem;line-height:1}
.mesa .mv{font-size:.74rem;font-weight:700;padding:2px 9px;border-radius:999px;background:#eef7f1;color:#1f8a4c}
