  <div class="chips">${['Todas',...CATS].map(c=>`<button class="chip ${st.cat===c?'act':''}" onclick="st.cat='${c}';render(true)">${c==='Todas'?'Todas':CATIC[c]+' '+c}</button>`).join('')}</div>
  <div class="prods" id="prods">${gridProds()}</div></section></div>`;
  return h;
}
function gridProds(){
  const b=st.busca.trim().toLowerCase();
  const ps=prodList().filter(p=>(st.cat==='Todas'||p.cat===st.cat)&&(!b||p.nome.toLowerCase().includes(b)));
  if(!Object.keys(S.produtos).length)return `<div class="vazio" style="grid-column:1/-1">Nenhum produto cadastrado.<br><br><button class="btn pri" onclick="go('produtos')">🥤 Cadastrar produtos</button></div>`;
  if(!ps.length)return `<div class="vazio" style="grid-column:1/-1">Nada encontrado.</div>`;
  return ps.map(p=>{const d=disponivel(p),esg=d<=0;
    return `<button class="prod ${esg?'esg':''}" onclick="addItem('${p.id}')"><div class="pi">${p.img?`<img src="${p.img}">`:(CATIC[p.cat]||'🍽️')}</div><b>${esc(p.nome)}</b><small>${esc(p.unidade||'')}</small><span class="pr">${brl(p.preco)}</span>${d!==Infinity?(esg?`<small class="st-esg">⛔ Esgotado</small>`:d<=estMin(p)?`<small class="low">⚠️ Restam ${d}</small>`:`<small>Estoque: ${d}</small>`):''}</button>`}).join('');
}
function filtrarProds(){const g=$('#prods');if(g)g.innerHTML=gridProds()}
function addItem(pid){
  if(!movAberto())return toast('Abra o movimento do dia primeiro (menu 🔐 Movimento).');
  const p=S.produtos[pid];if(!p)return;
  if(disponivel(p)<=0)return toast(`${p.nome} está sem estoque.`);
  const n=curMesa;mutate('mesas',n,m=>addNaComanda(m,pid,1));
  toast(`✅ ${p.nome} lançado — ${rotulo(n)}`);alertaEstoque([pid]);
}
function qtd(pid,d){
  if(d>0){const p=S.produtos[pid];if(p&&disponivel(p)<=0)return toast('Sem estoque suficiente.')}
  const n=curMesa;mutate('mesas',n,m=>{if(!m)return ABORT;return vazioMesa(n,addNaComanda(m,pid,d))});
  if(d>0)alertaEstoque([pid]);
}

/* ---------- FECHAR VENDA ---------- */
const soDig=x=>String(x||'').replace(/\D/g,'');
function validaCPF(c){c=soDig(c);if(c.length!==11||/^(\d)\1+$/.test(c))return false;
  for(let t=9;t<11;t++){let s=0;for(let i=0;i<t;i++)s+=c[i]*(t+1-i);if(((s*10)%11)%10!=c[t])return false}return true}
function validaCNPJ(c){c=soDig(c);if(c.length!==14||/^(\d)\1+$/.test(c))return false;
  const calc=n=>{let s=0,p=n-7;for(let i=0;i<n;i++){s+=c[i]*p--;if(p<2)p=9}const r=s%11;return r<2?0:11-r};return calc(12)==c[12]&&calc(13)==c[13]}
function fmtDoc(x){const d=soDig(x);
  if(d.length<=11)return d.replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d{1,2})$/,'$1-$2');
  return d.slice(0,14).replace(/^(\d{2})(\d)/,'$1.$2').replace(/^(\d{2})\.(\d{3})(\d)/,'$1.$2.$3').replace(/\.(\d{3})(\d)/,'.$1/$2').replace(/(\d{4})(\d)/,'$1-$2')}
const docValido=x=>{const d=soDig(x);return d.length===11?validaCPF(d):d.length===14?validaCNPJ(d):false};
const tipoDoc=x=>soDig(x).length===14?'CNPJ':'CPF';
function fecharVenda(){st.pag=null;st.cpf='';st.nota=false;modalVenda()}
function msgDoc(d){return d.length===11||d.length===14?(docValido(d)?`✅ ${tipoDoc(d)} válido`:`❌ ${tipoDoc(d)} inválido`):''}
function cpfInput(el){el.value=fmtDoc(el.value);st.cpf=el.value;
  const d=soDig(st.cpf);if(d.length&&!st.nota){st.nota=true;$('#fnota').checked=true}
  const ok=$('#cpfok');ok.textContent=msgDoc(d);ok.className=docValido(d)?'st-ok':'st-esg'}
function blocoCPF(){const d=soDig(st.cpf);return `<div class="card" style="background:#f7f4ee;box-shadow:none;padding:12px;margin-bottom:14px">
   <label style="margin-top:0">🧾 CPF na nota? (opcional)</label>
   <input id="fcpf" inputmode="numeric" placeholder="000.000.000-00" value="${esc(st.cpf)}" oninput="cpfInput(this)" maxlength="18">
   <small id="cpfok" class="${docValido(d)?'st-ok':'st-esg'}">${msgDoc(d)}</small>
   <label style="display:flex;gap:8px;align-items:center;color:var(--txt);font-size:1rem;margin-top:10px;cursor:pointer"><input type="checkbox" id="fnota" style="width:22px;height:22px" ${st.nota?'checked':''} onchange="st.nota=this.checked"> Cliente quer <b>nota fiscal</b> (NFC-e)</label></div>`}
function modalVenda(){
  const n=curMesa,its=mesa(n).itens||[],tot=totItens(its);
  abrirModal(`<h2>💰 Fechar venda — ${esc(rotulo(n))}</h2>
  <div class="cupom" style="max-height:180px;overflow:auto">${tabelaItens(its)}</div>
  <div class="totalBig">${brl(tot)}</div>
  <button class="btn" style="width:100%;margin-bottom:12px" onclick="imprimirConta('modalVenda()')">🖨️ Imprimir resumo p/ o cliente conferir <kbd class="k">F10</kbd></button>
  <b>Forma de pagamento</b>
  <div class="pags">${PAGS.map(([p,i])=>`<button class="${st.pag===p?'act':''}" onclick="st.pag='${p}';modalVenda()"><i>${i}</i>${p}<kbd class="k">${p[0]}</kbd></button>`).join('')}</div>
  ${blocoCPF()}
  <button class="btn ok big" ${st.pag?'':'disabled'} onclick="finalizar()">✅ Pagamento aprovado — Finalizar <kbd class="k">F8</kbd></button>
  <div class="row" style="margin-top:10px"><button class="btn" style="flex:1" onclick="fecharModal()">Voltar <kbd class="k">Esc</kbd></button></div>`,'venda');
}
/* fecha a comanda: usado pelo caixa e pelo app do garçom */
async function fecharComanda(n,{pag,cpf,nota,por}){
  if(!movAberto()){toast('O movimento do dia está fechado no caixa.');return null}
  const m=clone(mesa(n)),its=m.itens||[];if(!its.length||!pag)return null;
  cpf=soDig(cpf);if(cpf.length&&!docValido(cpf)){toast('❌ CPF/CNPJ inválido. Corrija ou apague o campo.');return null}
  const snap=JSON.stringify(its),rot=rotulo(n);
  const ok=await mutate('mesas',n,cur=>cur&&JSON.stringify(cur.itens||[])===snap?null:ABORT);
  if(!ok){toast('⚠️ Esta comanda acabou de mudar (pedido novo). Confira e feche de novo.');render(true);return null}
  const total=totItens(its),custo=custoItens(its);
  const v={id:uid(),mesa:n,rotulo:rot,itens:its,total,custo,lucro:total-custo,pagamento:pag,abertura:m.aberta||null,data:new Date().toISOString(),movId:S.estado.movId,
    cpf:cpf?fmtDoc(cpf):'',nota:nota?{status:'pendente'}:null,garcom:m.garcom||'',fechadoPor:por||'Caixa',
    cliente:isDel(n)?{nome:m.cliente,fone:m.fone,endereco:m.endereco,tipo:m.tipo}:null};
  put('vendas',v.id,v);
  const baixa={};its.forEach(i=>baixa[i.pid]=(baixa[i.pid]||0)+i.qtd);
  for(const pid in baixa)if(S.produtos[pid]&&controla(S.produtos[pid]))
    mutate('produtos',pid,p=>{if(!p||!controla(p))return ABORT;const q=baixa[pid];p.hist=histEst(p,'venda',-q,v.rotulo);p.estoque=Math.max(0,(+p.estoque||0)-q);return p});
  v._baixa=baixa;return v;
}
async function finalizar(){
  const n=curMesa;if(!st.pag)return;
  const v=await fecharComanda(n,{pag:st.pag,cpf:st.cpf,nota:st.nota});if(!v)return;
  const baixados=Object.keys(v._baixa).map(pid=>{const p=S.produtos[pid];return p&&controla(p)?`${v._baixa[pid]}x ${esc(nomeP(p))} → ficou ${p.estoque}`:null}).filter(Boolean);
  if(isDel(n))st.aba='delivery';
  go('mesas');
  abrirModal(`<div style="text-align:center"><div style="font-size:3.5rem">✅</div><h2>Venda finalizada!</h2>
  <p>${esc(v.rotulo)} ${isDel(n)?'concluído':'liberada'} · ${esc(v.pagamento)} · <b>${brl(v.total)}</b>${v.cpf?`<br>${tipoDoc(v.cpf)} na nota: <b>${v.cpf}</b>`:''}</p></div>
  ${v.nota?`<div class="aviso" style="margin:0 0 10px">🧾 Nota fiscal <b>a emitir</b> — ficou na lista <b>Notas a emitir</b> (menu Histórico).</div>`:''}
  ${baixados.length?`<div class="calc" style="font-size:.85rem">📦 Baixa automática no estoque:<br>${baixados.join('<br>')}</div>`:''}
  <div class="row" style="margin-top:14px"><button class="btn" style="flex:1" onclick="reimprimirUltimo()">🖨️ Recibo <kbd class="k">F9</kbd></button>
  ${v.nota?`<button class="btn acc" style="flex:1" onclick="notaModal('${v.id}')">🧾 Emitir nota</button>`:''}
  <button class="btn pri" style="flex:1" onclick="fecharModal()">OK <kbd class="k">Esc</kbd></button></div>`);
  alertaEstoque(Object.keys(v._baixa),'Estoque baixo após a venda!');
}

