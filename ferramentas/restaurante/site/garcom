nav button{background:linear-gradient(180deg,#fff,#f3f5f8)!important;border:1px solid #dfe3ea!important;border-radius:16px!important;box-shadow:var(--sombra);min-width:96px!important;min-height:94px;padding:10px 12px 8px!important;color:#1f2733!important;font-weight:700!important;justify-content:center}
:root[data-tema=escuro] nav button{background:linear-gradient(180deg,#161c26,#111620)!important;border-color:#263040!important;color:#e6ebf2!important}
nav button i{background:transparent!important;border:0!important;box-shadow:none!important;width:40px!important;height:38px!important;color:inherit!important}
nav button .nico{width:31px!important;height:31px!important;stroke-width:1.8}
nav button .mico{width:40px!important;height:28px!important}
nav button small{color:#6b7380!important}
nav button:hover{border-color:#b9c0cc!important;transform:translateY(-1px)}
nav button.act{background:linear-gradient(180deg,#e53935,#b71c1c)!important;border-color:#9b1717!important;color:#fff!important;box-shadow:0 8px 18px #c6282855,inset 0 1px 0 #ffffff40}
nav button.act i{color:#fff!important}nav button.act small{color:#ffffffcc!important}
/* painel central */
main{position:relative;z-index:1;background:var(--painel);border:1px solid #e3e7ed;border-radius:24px;box-shadow:0 10px 40px #1018280d;margin:10px auto 120px!important;padding:22px!important;backdrop-filter:blur(6px)}
