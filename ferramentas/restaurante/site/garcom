.gcats i{font-style:normal;font-size:2.6rem}.gcats small{color:var(--mut);font-weight:600;font-size:.78rem}
.gchips{display:flex;gap:6px;overflow-x:auto;padding:10px 12px;background:#f4f1ea;position:sticky;top:116px;z-index:4}
.gchips button{background:#fff;padding:9px 13px;border-radius:999px;font-weight:700;white-space:nowrap;box-shadow:0 1px 2px #0001}
.gchips button.act{background:var(--pri);color:#fff}
.gchips button:first-child{background:#d32f2f;color:#fff}
.gprod{background:#fff;border-radius:12px;padding:10px;display:flex;gap:10px;align-items:center;margin-bottom:8px;box-shadow:0 1px 2px #0001}
.gprod.esg{opacity:.5}
.gprod .thumb{width:58px;height:58px;font-size:1.9rem}
.imp-dl{background:var(--chip,#f4f6f8);border:1px solid var(--line);border-radius:12px;padding:10px 12px;margin:10px 0}.imp-dl small{display:block;margin-top:6px;color:var(--mut)}
.gprod .nm{flex:1;min-width:0;display:flex;flex-direction:column}.gpede{color:#b45309!important;font-weight:700}.gobs-bt{align-self:flex-start;margin-top:4px;border:1px dashed var(--line);background:transparent;border-radius:8px;padding:4px 10px;font-weight:700;color:inherit;cursor:pointer}.gobs-bt.falta{border:2px solid #e0a100;background:#fff3c4;color:#7a4a00}.gobs-ops{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 10px}.gobs-ops button{border:1px solid var(--line);background:var(--chip,#f3f3f3);color:inherit;border-radius:20px;padding:8px 14px;font-weight:700;font-size:1rem;cursor:pointer}.gprod .nm small{color:var(--mut)}.gprod .pr{color:var(--ok);font-weight:800}
.gqty{display:flex;align-items:center;gap:6px}
