body.v-mesas main{max-width:1600px}
/* abas mesas / delivery */
.tabs{background:#e9edf2!important;border:1px solid #dde2e9!important;border-radius:14px!important;padding:5px!important;box-shadow:inset 0 1px 2px #1018280d}
.tabs button{border-radius:10px!important;font-weight:700}
.tabs button.act{background:#fff!important;box-shadow:0 2px 6px #10182822,0 0 0 1px #dfe3ea!important}
