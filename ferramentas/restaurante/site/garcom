/* ---------- CÓDIGO DO PRODUTO E CÓDIGO DE BARRAS ---------- */
const casa=(p,b)=>p.nome.toLowerCase().includes(b)||String(p.codigo||'')===b||(!!p.barras&&p.barras===b);
function proxCodigo(){let m=+((S.config||{}).ultCodigo)||0;for(const p of Object.values(S.produtos))m=Math.max(m,+p.codigo||0);return m+1}
function guardarUltCodigo(c){mutate('config','geral',x=>(+((x||{}).ultCodigo)||0)>=c?ABORT:{...(x||{}),ultCodigo:c})}
function acharProduto(t){t=String(t||'').trim();if(!/^\d+$/.test(t))return null;const ps=Object.values(S.produtos);
  return ps.find(p=>p.barras&&p.barras===t)||ps.find(p=>String(p.codigo||'')===String(+t))||null}
function buscaProds(t){t=String(t||'').trim().toLowerCase();if(!t)return[];
  const ex=acharProduto(t);const l=prodList().filter(p=>casa(p,t));if(ex&&!l.includes(ex))l.unshift(ex);return l.slice(0,8)}
function migrarCodigos(){if(GARCOM)return;let c=proxCodigo();
  const sem=prodList().filter(p=>!p.codigo);sem.forEach(p=>{const cod=c++;mutate('produtos',p.id,cur=>cur&&!cur.codigo?{...cur,codigo:cod}:ABORT)});if(sem.length)guardarUltCodigo(c-1)}
/* lança pelo texto digitado (código, código de barras ou nome) na comanda n; devolve true se lançou */
function lancarTexto(n,t){t=String(t||'').trim();if(!t)return false;
