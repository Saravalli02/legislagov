header::after{content:"";position:absolute;left:300px;top:-60px;width:160px;height:150px;background:radial-gradient(closest-side,#e5393533,transparent);pointer-events:none}
header>*{position:relative;z-index:1}
.brand b{color:#fff!important;font-size:1.45rem}.brand span{color:#fff!important;opacity:.85;letter-spacing:4px!important}
#logo{width:50px;height:50px}
header .sino{background:#ffffff0d;border:1px solid #ffffff3d;color:#fff;width:46px;height:46px;border-radius:13px;box-shadow:none}
