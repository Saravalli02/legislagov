/* cartões de resumo com cor separando */
.stat{display:flex;align-items:center;gap:14px;box-shadow:var(--sombra);border:1px solid #e3e7ed!important;padding:16px 18px 16px 20px!important}
.stat::before{top:0!important;bottom:0!important;width:5px!important;border-radius:0!important}
