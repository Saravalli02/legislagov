function movDoRel(id){const movs=Object.values(S.movimentos).sort((a,b)=>b.abertura.localeCompare(a.abertura));return (id&&S.movimentos[id])||movAtual()||movs[0]||null}
function relEstoqueHtml(id){const m=movDoRel(id);if(!m)return `<div class="cupom"><div class="c">Nenhum movimento ainda.</div></div>`;
  const ini=m.abertura,fim=m.fechamento||new Date().toISOString();
  const vend={},vendApos={};
  Object.values(S.vendas).forEach(v=>{const alvo=v.movId===m.id?vend:(v.data>fim?vendApos:null);if(!alvo)return;(v.itens||[]).forEach(i=>alvo[i.pid]=(alvo[i.pid]||0)+i.qtd)});
  const linhas=[],sem=[];
  prodList().forEach(p=>{const vd=vend[p.id]||0;
    if(!controla(p)){if(vd)sem.push({p,vd});return}
    let ent=0,aj=0,depois=0;(p.hist||[]).forEach(h=>{if(h.t==='venda')return;if(h.d>fim)depois+=+h.q||0;else if(h.d>=ini){if(h.t==='ajuste')aj+=+h.q||0;else ent+=+h.q||0}});
    const restou=(+p.estoque||0)-depois+(vendApos[p.id]||0),inicio=restou-ent-aj+vd;
    linhas.push({p,vd,ent,aj,restou,inicio})});
  linhas.sort((a,b)=>a.p.nome.localeCompare(b.p.nome,'pt-BR'));
  const acab=linhas.filter(l=>l.restou<=0).length,baixo=linhas.filter(l=>l.restou>0&&l.restou<=(+l.p.estoqueMin||0)).length;
