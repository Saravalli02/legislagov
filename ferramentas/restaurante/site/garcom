    if(n>w*h*0.03&&n<w*h*0.97){const corta=(v,tot)=>{let s=0,a1=0,b1=v.length-1;const lim=tot*0.02;for(;a1<v.length;a1++){s+=v[a1];if(s>lim)break}s=0;for(;b1>=0;b1--){s+=v[b1];if(s>lim)break}return [a1,b1]};
      const [x1,x2]=corta(col,n),[y1,y2]=corta(lin,n);if(x2>x1&&y2>y1){cx=(x1+x2+1)/2/a;cy=(y1+y2+1)/2/a;lado=Math.max(x2-x1+1,y2-y1+1)/a*1.16;fundo=`rgb(${bg.join(',')})`}}}
  lado=Math.max(16,Math.min(lado,fundo?Math.max(W,H)*1.2:Math.min(W,H)));
  const t=Math.min(max,Math.max(240,Math.round(lado))),c=document.createElement('canvas');c.width=c.height=t;const x=c.getContext('2d'),e=t/lado;
  x.fillStyle=fundo||'#fff';x.fillRect(0,0,t,t);x.imageSmoothingQuality='high';x.drawImage(im,(t/2)-cx*e,(t/2)-cy*e,W*e,H*e);return c.toDataURL('image/jpeg',.8)}
function lerImgProduto(file,max,cb){if(!file)return;const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{let u;try{u=centralizarImg(im,max)}catch(e){u=null}
