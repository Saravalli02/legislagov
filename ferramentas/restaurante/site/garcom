  if(!aberto&&!digitando()&&(view==='mesas'||view==='mesa')){const agora=Date.now();
    if(/^\d$/.test(k)){scan=(agora-scanT<60?scan:'')+k;scanT=agora}
    else if(k==='Enter'&&scan.length>=6&&agora-scanT<120){e.preventDefault();const c=scan;scan='';numBuf='';
      const p=acharProduto(c);if(!p){toast(`Código de barras ${c} não cadastrado. Cadastre em Produtos.`);return}
      if(view==='mesa')lancarEm(curMesa,p.id);else{lancarEm(BAL,p.id);balRedesenhar(false)}return}}
  if(ACG&&view==='pdv'&&!aberto){
    if(k==='F5'){e.preventDefault();pdvDescontoVenda();return}
    if(k==='Delete'&&!(document.activeElement&&document.activeElement.value)){e.preventDefault();pdvExcluirUltimo();return}
    if(!digitando()&&k.length===1){const q=$('#pdq');if(q)q.focus()}}
  if(view==='mesa'&&!aberto&&!digitando()&&/^\d$/.test(k)){const f=$('#view [data-focus]');if(f){f.focus()}}
  if(view==='mesas'&&!aberto&&!digitando()){
    if(/^\d$/.test(k)){numBuf=(numBuf+k).slice(-2);if(scan.length<3)toast(`Mesa ${numBuf} — aperte Enter para abrir`)}
    else if(k==='Enter'&&numBuf){const n=+numBuf;numBuf='';if(n>=1&&n<=NM())abrirMesa(n);else toast('Mesa inválida (1 a '+NM()+')')}
    else if(k==='Backspace'){numBuf=numBuf.slice(0,-1)}}
});

