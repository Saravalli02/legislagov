/* ---------- CAIXA DA COMANDA ---------- */
function vMesa(){
  const n=curMesa,m=mesa(n),its=m.itens||[],tot=totItens(its),dl=isDel(n);
  if(dl&&!S.mesas[n]){setTimeout(()=>go('mesas'));return ''}
  let h=avisoMov()+`<div class="row" style="margin-bottom:12px"><button class="btn" onclick="${dl?"st.aba='delivery';":''}go('mesas')">← ${dl?'Pedidos':'Mesas'}</button><h2 style="margin:0;flex:1">${esc(rotulo(n))}</h2>${m.aberta&&its.length?`<span style="color:var(--mut)">aberta às ${hr(m.aberta)}${m.garcom?' · 👤 '+esc(m.garcom):''}</span>`:''}</div>`;
  if(m.conta)h+=`<div class="aviso" style="background:#fdecea;border-color:#f3a59c">🧾 <span style="flex:1"><b>${esc(m.conta.por||'Garçom')}</b> pediu a conta às ${hr(m.conta.hora)}.</span><button class="btn" onclick="mutate('mesas','${n}',x=>x?{...x,conta:null}:ABORT)">Limpar aviso</button></div>`;
  if(dl)h+=`<div class="card" style="margin-bottom:12px"><div class="row"><div style="flex:1"><b>${esc(m.cliente)}</b>${m.fone?` · 📞 ${esc(m.fone)}`:''}${m.endereco?`<br>📍 ${esc(m.endereco)}`:''}${m.obs?`<br>📝 ${esc(m.obs)}`:''}</div><button class="btn" onclick="editarCliente('${n}')">✏️ Editar</button></div>
  <div class="chips" style="margin-bottom:0">${Object.entries(STATUS).filter(([k])=>k!=='saiu'||m.tipo==='entrega').map(([k,[i,t]])=>`<button class="chip ${(m.status||'preparo')===k?'act':''}" onclick="setStatus('${n}','${k}')">${i} ${t}</button>`).join('')}</div></div>`;
  h+=`<div class="caixa"><section class="card"><h3>🧾 Comanda — tudo que ${dl?'o cliente pediu':'a mesa consumiu'}</h3>`;
  if(!its.length)h+=`<div class="vazio"><span style="display:inline-block;color:#8a6a4a">${dl?'🥡':MESA_LIVRE}</span><br>${dl?'Nenhum item ainda.':'Mesa livre.'} Toque nos produtos ao lado para lançar.</div>`;
  its.forEach(i=>{const p=S.produtos[i.pid];
    h+=`<div class="it"><div class="thumb">${p&&p.img?`<img src="${p.img}">`:(CATIC[p&&p.cat]||'🍽️')}</div>
    <div class="nm"><b>${esc(i.nome)}</b><small>${brl(i.preco)} cada</small></div>
    <div class="qty"><button onclick="qtd('${i.pid}',-1)">−</button><span>${i.qtd}</span><button onclick="qtd('${i.pid}',1)">+</button></div>
    <div class="sub">${brl(i.preco*i.qtd)}</div></div>`});
  h+=`<div class="total"><span>Total</span><span>${brl(tot)}</span></div>
  <div class="row"><button class="btn" style="flex:1" ${its.length?'':'disabled'} onclick="imprimirConta()">🖨️ Imprimir consumo <kbd class="k">F10</kbd></button>
  <button class="btn acc" style="flex:1.4" ${its.length?'':'disabled'} onclick="fecharVenda()">💰 Fechar venda <kbd class="k">F8</kbd></button></div>
  ${(m.pedidos||[]).length?`<h3 style="margin-top:16px">🧑‍🍳 Pedidos enviados pelos garçons</h3>${m.pedidos.slice().reverse().map(p=>`<div class="pedlog"><b>${hr(p.hora)} · ${esc(p.por)}</b> — ${p.itens.map(i=>i.qtd+'x '+esc(i.nome)).join(', ')}${p.obs?`<br><i>📝 ${esc(p.obs)}</i>`:''}</div>`).join('')}`:''}</section>
