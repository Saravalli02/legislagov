  for(const [id,f] of Object.entries(S.fila)){if(filaVista.has(id))continue;filaVista.add(id);del('fila',id);
    if(!f.html&&f.ped)f.html=ticketPedido(f.ped);if(!f.html)continue;
    const titulo=f.tipo==='conta'?`🧾 <b>${esc(f.por)}</b> pediu a conta — <b>${esc(f.rotulo)}</b>`:f.tipo==='pedido'?`🍳 <b>${esc(f.rotulo)}</b> para imprimir (${esc(f.por)})`:`🧾 Recibo — <b>${esc(f.rotulo)}</b> (fechado por ${esc(f.por)})`;
    if(lsGet('lg-autoprint','0')==='1'&&$('#modalBg').classList.contains('hidden')){bip();imprimir(f.html,'impressao-'+id);doPrint()}
    else novoAvisoCaixa({html:titulo,print:f.html,nome:'impressao-'+id})}}
hooks.push((col,id,old,nw)=>{
  if(col==='*'||col==='fila')processaFila();
  if(!GARCOM&&col==='mesas'&&nw&&!old&&isDel(id)&&nw.origem==='cardapio')novoAvisoCaixa({html:`📲 <b>Novo pedido do cardápio nº ${esc(nw.num)}</b> — ${esc(nw.cliente||'')} · ${nw.tipo==='entrega'?'entrega':nw.tipo==='local'?'comer no local':'retirada'} · ${brl(totItens(nw.itens||[]))}`,abrir:id});
  if(GARCOM||col!=='mesas'||!nw)return;
  const po=(old&&old.pedidos)||[],pn=nw.pedidos||[];
  const novos=pn.filter(p=>!po.some(q=>q.id===p.id)&&p.dev!==DEV);
  novos.forEach(p=>novoAvisoCaixa({html:`🧑‍🍳 <b>${esc(rotulo(id))}</b> — ${esc(p.por)}: ${p.itens.map(i=>i.qtd+'x '+esc(i.nome)).join(', ')}${p.obs?` <i>(${esc(p.obs)})</i>`:''}`,abrir:id}));
  if(nw.conta&&!(old&&old.conta)&&nw.conta.dev!==DEV&&!novos.length&&lsGet('lg-printer','1')!=='1')novoAvisoCaixa({html:`🧾 <b>${esc(rotulo(id))}</b> — ${esc(nw.conta.por)} pediu a conta`,abrir:id});
});

/* =================== APP DO GARÇOM =================== */
const g={tela:'mesas',mesa:null,aba:'pedido',cat:null,pin:'',sel:null,carts:{},obs:'',imprimirCaixa:true};
try{g.carts=JSON.parse(lsGet('lg-carts','{}'))||{}}catch(e){}
const gUser=()=>(S.config.garcons||[]).find(x=>x.id===lsGet('lg-garcom'));
const cart=()=>g.carts[g.mesa]||(g.carts[g.mesa]={});
const saveCarts=()=>lsSet('lg-carts',JSON.stringify(g.carts));
const cartItens=()=>Object.entries(cart()).filter(([pid,q])=>q>0&&S.produtos[pid]).map(([pid,q])=>({p:S.produtos[pid],q}));
function gGo(t,extra){Object.assign(g,{tela:t},extra||{});render(true);window.scrollTo(0,0)}
function gRender(){
  document.body.classList.add('gmode');
  const u=gUser();let h='';
  if(!u)return gLogin();
  h+=`<div class="gtop"><div class="logo" style="width:38px;height:38px">${S.config.logo?`<img src="${S.config.logo}">`:LOGO_SVG}</div><div style="flex:1;line-height:1.1"><b>LegislaGov</b><br><small>👤 ${esc(u.nome)}${mode==='api'?(online?' · 🟢 online':' · 🔴 sem conexão'):''}</small></div><button class="gbtn" style="white-space:nowrap" onclick="atualizarApp()" title="Atualizar o app">↻ Atualizar${novaVersao?' •':''}</button><button class="gbtn" onclick="confirmar('Sair do app?',()=>{lsSet('lg-garcom',null);render(true)})">Sair</button></div>`;
  if(!movAberto())h+=`<div class="aviso" style="margin:10px">⚠️ O caixa ainda não abriu o movimento do dia. Os pedidos só podem ser enviados depois.</div>`;
  if(g.tela==='mesas')h+=gMesas();
  else if(g.tela==='mesa')h+=gMesa();
  else if(g.tela==='carrinho')h+=gCarrinho();
  else if(g.tela==='fechar')h+=gFechar();
  return h;
}
function gLogin(){const gs=S.config.garcons||[];
  let h=`<div class="glogin"><div class="logo" style="width:84px;height:84px;margin:0 auto">${S.config.logo?`<img src="${S.config.logo}">`:LOGO_SVG.replace('width="34" height="34"','width="56" height="56"')}</div><h2 style="text-align:center;margin:12px 0 2px">LegislaGov Restaurante</h2><p style="text-align:center;color:var(--mut);margin:0 0 18px">App do Garçom</p>`;
  if(!gs.length)return h+`<div class="card vazio">Nenhum garçom cadastrado.<br>Peça ao caixa para cadastrar em <b>⚙️ Ajustes → Garçons</b>.</div></div>`;
  if(!g.sel)return h+`<b>Quem é você?</b><div class="gnomes">${gs.map(x=>`<button onclick="g.sel='${x.id}';g.pin='';render(true)">👤<br>${esc(x.nome)}</button>`).join('')}</div></div>`;
  const x=gs.find(y=>y.id===g.sel);
  return h+`<p style="text-align:center"><b>${esc(x?x.nome:'')}</b>, digite seu PIN</p><div class="pindots">${[0,1,2,3].map(i=>`<span class="${g.pin.length>i?'on':''}"></span>`).join('')}</div>
  <div class="pinpad">${[1,2,3,4,5,6,7,8,9,'←',0,'⌫'].map(k=>`<button onclick="gPin('${k}')">${k}</button>`).join('')}</div></div>`}
function gPin(k){if(k==='←'){g.sel=null;g.pin='';return render(true)}if(k==='⌫'){g.pin=g.pin.slice(0,-1);return render(true)}
  g.pin+=k;if(g.pin.length===4){const x=(S.config.garcons||[]).find(y=>y.id===g.sel);
    if(x&&x.pin===g.pin){lsSet('lg-garcom',x.id);g.pin='';g.sel=null;toast('Olá, '+x.nome+'! 👋')}else{g.pin='';toast('❌ PIN errado')}}
  render(true)}
function gMesas(){
  let h=`<div class="gpad"><h2 style="margin:6px 0 10px">Escolha a mesa</h2><div class="gmesas">`;
  for(let i=1;i<=NM();i++){const t=totMesa(i),m=mesa(i),c=Object.values(g.carts[String(i)]||{}).reduce((a,b)=>a+b,0);
    h+=`<button class="${t>0?'ocupada':''} ${m.conta?'conta':''}" onclick="gGo('mesa',{mesa:'${i}',aba:'pedido',cat:null})"><span class="ic">${t>0?MESA_OC:MESA_LIVRE}</span><b>${i}</b><small>${t>0?brl(t):'Livre'}</small>${m.conta?'<em>🧾 conta</em>':c?`<em>🛒 ${c}</em>`:''}</button>`}
  return h+'</div></div>'}
function gMesa(){
  const n=g.mesa,m=mesa(n),its=m.itens||[],tot=totItens(its);
  let h=`<div class="gbar"><button class="gbtn" onclick="gGo('mesas')">← Mesas</button><b style="flex:1;font-size:1.25rem">Mesa ${n}</b><span><small>Total</small><br><b>${brl(tot)}</b></span></div>
  <div class="gtabs"><button class="${g.aba==='pedido'?'act':''}" onclick="g.aba='pedido';render(true)">🍽️ Fazer pedido</button><button class="${g.aba==='conta'?'act':''}" onclick="g.aba='conta';render(true)">🧾 Conta ${tot?brl(tot):''}</button></div>`;
  if(g.aba==='conta')return h+gConta();
  const cats=CATS.filter(c=>prodList().some(p=>p.cat===c));
  if(!g.cat){h+=`<div class="gpad"><div class="gcats">${cats.map(c=>`<button onclick="g.cat='${c}';render(true)"><i>${CATIC[c]}</i>${c}<small>${prodList().filter(p=>p.cat===c).length} itens</small></button>`).join('')}</div>${!cats.length?'<div class="card vazio">Nenhum produto cadastrado no caixa.</div>':''}</div>`}
  else{h+=`<div class="gchips"><button onclick="g.cat=null;render(true)">☰ Menus</button>${cats.map(c=>`<button class="${g.cat===c?'act':''}" onclick="g.cat='${c}';render(true);window.scrollTo(0,0)">${CATIC[c]} ${c}</button>`).join('')}</div><div class="gpad">`;
    prodList().filter(p=>p.cat===g.cat).forEach(p=>{const q=cart()[p.id]||0,d=disponivel(p)-q;
      h+=`<div class="gprod ${disponivel(p)<=0?'esg':''}"><div class="thumb">${p.img?`<img src="${p.img}">`:(CATIC[p.cat]||'🍽️')}</div><div class="nm"><b>${esc(p.nome)}</b><small>${p.codigo?'cód. '+p.codigo+(p.unidade?' · ':''):''}${esc(p.unidade||'')}</small><span class="pr">${brl(p.preco)}</span>${disponivel(p)<=0?'<small class="st-esg">⛔ Esgotado</small>':d!==Infinity&&d<=estMin(p)?`<small class="low">⚠️ restam ${Math.max(0,d)}</small>`:''}</div>
      <div class="gqty">${q?`<button onclick="gAdd('${p.id}',-1)">−</button><span>${q}</span>`:''}<button class="mais" onclick="gAdd('${p.id}',1)">+</button></div></div>`});
    h+='</div>'}
  const ci=cartItens();
  if(ci.length)h+=`<div class="gcart" onclick="gGo('carrinho')"><span>🛒 <b>${ci.reduce((a,x)=>a+x.q,0)} itens</b> · ${brl(ci.reduce((a,x)=>a+x.q*x.p.preco,0))}</span><b>Ver e enviar ▸</b></div>`;
  return h}
function gAdd(pid,d){const c=cart(),p=S.produtos[pid];if(!p)return;
  if(d>0&&disponivel(p)-(c[pid]||0)<=0)return toast(`${p.nome} sem estoque`);
  c[pid]=Math.max(0,(c[pid]||0)+d);if(!c[pid])delete c[pid];saveCarts();render(true)}
function gCarrinho(){const ci=cartItens(),t=ci.reduce((a,x)=>a+x.q*x.p.preco,0);
  let h=`<div class="gbar"><button class="gbtn" onclick="gGo('mesa')">← Continuar</button><b style="flex:1;font-size:1.15rem">Pedido — Mesa ${g.mesa}</b></div><div class="gpad">`;
  if(!ci.length)return h+`<div class="card vazio">Nenhum item escolhido.</div></div>`;
  ci.forEach(({p,q})=>{h+=`<div class="gprod"><div class="thumb">${p.img?`<img src="${p.img}">`:(CATIC[p.cat]||'🍽️')}</div><div class="nm"><b>${esc(p.nome)}</b><small>${brl(p.preco)} cada</small><span class="pr">${brl(p.preco*q)}</span></div><div class="gqty"><button onclick="gAdd('${p.id}',-1)">−</button><span>${q}</span><button class="mais" onclick="gAdd('${p.id}',1)">+</button></div></div>`});
  h+=`<div class="total"><span>Total do pedido</span><span>${brl(t)}</span></div>
  <label>📝 Observação para a cozinha</label><input id="gobs" value="${esc(g.obs)}" oninput="g.obs=this.value" placeholder="Ex.: sem cebola, bem passado">
  <button class="btn ok big" style="margin-top:14px" onclick="gEnviar()">📤 Enviar pedido para o caixa</button>
  <button class="btn big" style="margin-top:8px" onclick="g.carts[g.mesa]={};saveCarts();gGo('mesa')">🗑️ Limpar pedido</button></div>`;
  return h}
async function gEnviar(){
  if(!movAberto())return toast('O caixa ainda não abriu o movimento.');
  const u=gUser(),n=g.mesa,ci=cartItens();if(!ci.length)return;
  for(const {p,q} of ci)if(disponivel(p)<q)return toast(`⛔ ${p.nome}: só tem ${Math.max(0,disponivel(p))} no estoque`);
  const ped={id:uid(),por:u.nome,dev:DEV,hora:new Date().toISOString(),itens:ci.map(({p,q})=>({nome:nomeP(p),qtd:q})),obs:g.obs.trim()};
  const ok=await mutate('mesas',n,m=>{for(const {p,q} of ci)m=addNaComanda(m,p.id,q,u.nome);m.pedidos=[...(m.pedidos||[]),ped].slice(-40);return m});
  if(!ok)return toast('Não foi possível enviar. Tente de novo.');
  g.carts[n]={};g.obs='';saveCarts();toast('✅ Pedido enviado para o caixa!');alertaEstoque(ci.map(x=>x.p.id));gGo('mesa',{aba:'conta',cat:null});
  gPerguntarImpressao(n,ped,u)}
let gUltPed=null;
function gPerguntarImpressao(n,ped,u){gUltPed={n,ped,u};
  abrirModal(`<div style="text-align:center"><div class="hic" style="width:64px;height:64px;border-radius:18px;margin:0 auto 12px;display:grid"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 9V3.5h10V9"/><rect x="3.5" y="9" width="17" height="8" rx="2"/><path d="M7 14h10v6.5H7z"/></svg></div>
  <h2 style="justify-content:center">Imprimir este pedido?</h2><p style="color:var(--mut)">O pedido já está lançado na Mesa ${n}. Imprimir manda o papel para a cozinha (na impressora do caixa).</p>
  <div class="row" style="margin-top:14px"><button class="btn big" style="flex:1" onclick="fecharModal()">Não</button><button class="btn ok big" style="flex:1.4" onclick="gImprimirPedido()">🖨️ Sim, imprimir</button></div></div>`)}
async function gImprimirPedido(){const x=gUltPed;fecharModal();if(!x)return;
  await mutate('estado','atual',e=>({...(e||{}),seq:((e&&e.seq)||0)+1}));
  const num=(S.estado&&S.estado.seq)||'';
  await put('fila',uid(),{tipo:'pedido',rotulo:'Pedido nº '+num+' — Mesa '+x.n,por:x.u.nome,html:ticketPedido({num,mesa:x.n,itens:x.ped.itens,obs:x.ped.obs,por:x.u.nome,hora:x.ped.hora}),ts:Date.now()});
  toast('🖨️ Pedido nº '+num+' enviado para imprimir')}
function gConta(){const n=g.mesa,m=mesa(n),its=m.itens||[],tot=totItens(its);
  let h=`<div class="gpad">`;
  if(!its.length)return h+`<div class="card vazio">Mesa sem consumo ainda.</div></div>`;
  h+=`<div class="card">${its.map(i=>`<div class="it"><div class="nm"><b>${i.qtd}x ${esc(i.nome)}</b><small>${brl(i.preco)} cada</small></div><div class="sub">${brl(vIt(i))}</div></div>`).join('')}
  <div class="total"><span>Total</span><span>${brl(tot)}</span></div></div>
  ${m.conta?`<div class="aviso" style="margin-top:10px">🧾 Conta pedida por ${esc(m.conta.por)} às ${hr(m.conta.hora)}.</div>`:''}
  <button class="btn pri big" style="margin-top:12px" onclick="gPedirConta()">🖨️ Pedir conta — imprime no caixa</button>
  <button class="btn acc big" style="margin-top:8px" onclick="st.pag=null;st.cpf='';st.nota=false;gGo('fechar')">💳 Fechar pelo app (maquininha)</button>
  ${(m.pedidos||[]).length?`<h3 style="margin-top:18px">Pedidos enviados</h3>${m.pedidos.slice().reverse().map(p=>`<div class="pedlog"><b>${hr(p.hora)} · ${esc(p.por)}</b> — ${p.itens.map(i=>i.qtd+'x '+esc(i.nome)).join(', ')}${p.obs?`<br><i>📝 ${esc(p.obs)}</i>`:''}</div>`).join('')}`:''}</div>`;
  return h}
function resumoHtml(n){const its=mesa(n).itens||[];return `<div class="cupom">${cupomCab()}<hr><div class="c">RESUMO — CONFERÊNCIA<br>${esc(rotulo(n))} · ${dt(new Date().toISOString())}${mesa(n).garcom?'<br>Garçom: '+esc(mesa(n).garcom):''}</div><hr>${tabelaItens(its)}<hr>
  <table><tr><td>Itens</td><td class="n">${its.reduce((s,i)=>s+i.qtd,0)}</td></tr><tr><td><b>TOTAL</b></td><td class="n"><b>${brl(totItens(its))}</b></td></tr></table><hr><div class="c">NÃO É DOCUMENTO FISCAL<br>Confira antes de pagar</div></div>`}
async function gPedirConta(){const u=gUser(),n=g.mesa;
  await mutate('mesas',n,m=>m?{...m,conta:{por:u.nome,dev:DEV,hora:new Date().toISOString()}}:ABORT);
  await put('fila',uid(),{tipo:'conta',rotulo:rotulo(n),por:u.nome,html:resumoHtml(n),ts:Date.now()});
  toast('🖨️ Conta enviada para imprimir no caixa');render(true)}
function gFechar(){const n=g.mesa,its=mesa(n).itens||[],tot=totItens(its);
  return `<div class="gbar"><button class="gbtn" onclick="gGo('mesa',{aba:'conta'})">← Voltar</button><b style="flex:1;font-size:1.15rem">Fechar Mesa ${n}</b></div><div class="gpad">
  <div class="totalBig">${brl(tot)}</div><b>Forma de pagamento</b>
  <div class="pags">${PAGS.map(([p,i])=>`<button class="${st.pag===p?'act':''}" onclick="st.pag='${p}';render(true)"><i>${i}</i>${p}</button>`).join('')}</div>
  ${blocoCPF()}
  <label class="chk"><input type="checkbox" ${g.imprimirCaixa?'checked':''} onchange="g.imprimirCaixa=this.checked"><span>Imprimir o recibo no caixa</span></label>
  <button class="btn ok big" style="margin-top:12px" ${st.pag?'':'disabled'} onclick="gFinalizar()">✅ Pagamento aprovado — Finalizar</button></div>`}
async function gFinalizar(){const u=gUser(),n=g.mesa;
  const v=await fecharComanda(n,{pag:st.pag,cpf:st.cpf,nota:st.nota,por:u.nome});if(!v)return;
  if(g.imprimirCaixa)put('fila',uid(),{tipo:'recibo',rotulo:v.rotulo,por:u.nome,html:cupomVenda(v),ts:Date.now()});
  g.carts[n]={};saveCarts();gGo('mesas');
  abrirModal(`<div style="text-align:center"><div style="font-size:3.5rem">✅</div><h2>Mesa ${n} fechada!</h2><p>${esc(v.pagamento)} · <b>${brl(v.total)}</b>${v.cpf?'<br>CPF na nota: '+v.cpf:''}</p>${g.imprimirCaixa?'<p>🖨️ O recibo vai sair na impressora do caixa.</p>':''}<button class="btn pri big" onclick="fecharModal()">OK</button></div>`)}

/* ---------- modal ---------- */
let modalTipo=null;
function abrirModal(h,tipo){modalTipo=tipo||null;$('#modal').innerHTML=h;lgEnfeitar($('#modal'));$('#modalBg').classList.remove('hidden')}
function fecharModal(){modalTipo=null;$('#modalBg').classList.add('hidden');$('#modal').innerHTML=''}
$('#modalBg').addEventListener('click',e=>{if(e.target.id==='modalBg')fecharModal()});
let _cb=null;
function confirmar(msg,cb){_cb=cb;abrirModal(`<p style="font-size:1.1rem">${msg}</p><div class="row"><button class="btn" style="flex:1" onclick="fecharModal()">Cancelar</button><button class="btn pri" style="flex:1" onclick="const f=_cb;fecharModal();f&&f()">Confirmar</button></div>`)}

iniciar();
</script>
