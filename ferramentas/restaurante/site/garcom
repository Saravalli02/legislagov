 <div class="${ACG?'hidden':''}"><label>Quantidade de mesas</label><input id="cm" type="number" min="1" max="60" inputmode="numeric" value="${+(c.mesas)||15}"></div>
  <button class="btn ok" style="margin-top:12px" onclick="salvarLoja()">💾 Salvar dados</button></div>
  </div>${mode==='api'?`<div class="card" style="margin-top:14px;display:flex;align-items:center;gap:12px;flex-wrap:wrap"><div style="flex:1"><b>Conectado como ${esc(lsGet('lg-nome','')||'usuário do restaurante')}</b><br><small style="color:var(--mut)">Para trocar de usuário neste aparelho, saia e entre de novo.</small></div><button class="btn" onclick="sairRest()">Sair deste aparelho</button></div>`:''}<p style="color:var(--mut);font-size:.85rem;margin-top:16px">${mode==='api'?(ACG?'☁️ Dados no servidor GR Software (AWS), separados de qualquer outro cliente. Todos os caixas veem tudo em tempo real.':'☁️ Dados no servidor GR Software (AWS) — caixa e garçons veem tudo em tempo real.'):mode==='db'?'☁️ Dados salvos na nuvem do Claude.':'💾 Dados salvos somente neste aparelho/navegador.'}</p>`}
function salvarLoja(){const d={razao:$('#cr').value.trim(),cnpj:$('#cc').value.trim(),endereco:$('#ce').value.trim(),fone:$('#cf').value.trim(),mesas:Math.max(1,Math.min(60,parseInt($('#cm').value,10)||15))};
  mutate('config','geral',c=>({...(c||{}),...d}));toast('✅ Dados salvos')}
function addGarcom(){const nome=$('#gn').value.trim(),pin=soDig($('#gp').value);
  if(!nome)return toast('Informe o nome do garçom.');if(pin.length!==4)return toast('O PIN precisa ter 4 números.');
  if((S.config.garcons||[]).some(g=>g.pin===pin))return toast('Esse PIN já é de outro garçom.');
  mutate('config','geral',c=>({...(c||{}),garcons:[...((c&&c.garcons)||[]),{id:uid(),nome,pin}]}));toast('✅ '+nome+' cadastrado')}
function removerGarcom(id){const g=(S.config.garcons||[]).find(x=>x.id===id);confirmar(`Remover o garçom <b>${esc(g.nome)}</b>?`,()=>mutate('config','geral',c=>({...c,garcons:(c.garcons||[]).filter(x=>x.id!==id)})))}
function trocarPin(id){abrirModal(`<h2>🔑 Novo PIN</h2><input id="np" inputmode="numeric" maxlength="4" placeholder="4 números"><div class="row" style="margin-top:12px"><button class="btn" style="flex:1" onclick="fecharModal()">Cancelar</button><button class="btn ok" style="flex:1" onclick="const p=soDig($('#np').value);if(p.length!==4)return toast('4 números');if((S.config.garcons||[]).some(g=>g.pin===p&&g.id!=='${id}'))return toast('PIN já usado');mutate('config','geral',c=>({...c,garcons:(c.garcons||[]).map(g=>g.id==='${id}'?{...g,pin:p}:g)}));fecharModal();toast('PIN alterado')">Salvar</button></div>`)}
async function copiar(t,msg){try{await navigator.clipboard.writeText(t);toast(msg||'Copiado')}catch(e){toast('Não deu para copiar — selecione o texto')}}

/* ---------- avisos do caixa (pedidos dos garçons, conta, impressão) ---------- */
function bip(){try{const a=new (window.AudioContext||window.webkitAudioContext)(),o=a.createOscillator(),g=a.createGain();o.connect(g);g.connect(a.destination);o.frequency.value=880;g.gain.value=.15;o.start();o.frequency.setValueAtTime(660,a.currentTime+.15);o.stop(a.currentTime+.3)}catch(e){}}
let avisosCaixa=[];
function mostrarAvisosCaixa(){const a=$('#alerta');if(!avisosCaixa.length){a.classList.add('hidden');return}
  a.innerHTML=`<h4 style="color:var(--pri)">🔔 Avisos dos garçons <span style="float:right;cursor:pointer" onclick="event.stopPropagation();avisosCaixa=[];mostrarAvisosCaixa()">✕</span></h4>${avisosCaixa.map((x,i)=>`<div class="row" style="border-top:1px solid var(--line);padding:6px 0"><span style="flex:1">${x.html}</span>${x.print?`<button class="btn pri" onclick="event.stopPropagation();imprimirAviso(${i})">🖨️</button>`:''}${x.abrir?`<button class="btn" onclick="event.stopPropagation();avisosCaixa.splice(${i},1);mostrarAvisosCaixa();abrirMesa('${x.abrir}')">Abrir</button>`:''}</div>`).join('')}`;
  a.classList.remove('hidden');clearTimeout(a._h);a.onclick=null}
function imprimirAviso(i){const x=avisosCaixa[i];avisosCaixa.splice(i,1);mostrarAvisosCaixa();imprimir(x.print,x.nome)}
function novoAvisoCaixa(x){avisosCaixa.unshift(x);avisosCaixa=avisosCaixa.slice(0,6);bip();mostrarAvisosCaixa()}
const filaVista=new Set();
function processaFila(){if(GARCOM||lsGet('lg-printer','1')!=='1')return;
  for(const [id,f] of Object.entries(S.fila)){if(filaVista.has(id))continue;filaVista.add(id);del('fila',id);
    if(!f.html&&f.ped)f.html=ticketPedido(f.ped);if(!f.html)continue;
    const titulo=f.tipo==='conta'?`🧾 <b>${esc(f.por)}</b> pediu a conta — <b>${esc(f.rotulo)}</b>`:f.tipo==='pedido'?`🍳 <b>${esc(f.rotulo)}</b> para imprimir (${esc(f.por)})`:`🧾 Recibo — <b>${esc(f.rotulo)}</b> (fechado por ${esc(f.por)})`;
    if(qzPrinter()||impDireta()){bip();enviarDireto(f.html).then(ok=>{if(!ok)novoAvisoCaixa({html:titulo,print:f.html,nome:'impressao-'+id})})}
    else if(lsGet('lg-autoprint','0')==='1'&&$('#modalBg').classList.contains('hidden')){bip();imprimir(f.html,'impressao-'+id);doPrint()}
    else novoAvisoCaixa({html:titulo,print:f.html,nome:'impressao-'+id})}}
hooks.push((col,id,old,nw)=>{
  if(ACG&&(col==='*'||col==='reservas')){const n=reservasL().filter(r=>r.status==='nova').length,e=document.getElementById('pedN');if(e)e.textContent=n?n+' nova(s)':'\u00a0'}
  if(ACG&&col==='reservas'&&nw&&!old&&nw.status==='nova')novoAvisoCaixa({html:`📲 <b>Novo pedido nº ${esc(nw.num)}</b> — ${esc(nw.nome)} · ${(nw.itens||[]).reduce((s,i)=>s+i.qtd,0)} item(ns)${nw.retirada?' · retira '+esc(nw.retirada):''}`,print:cupomReserva(nw),nome:'pedido-'+nw.num});
  if(col==='*'||col==='fila')processaFila();
  if(!GARCOM&&col==='mesas'&&nw&&!old&&isDel(id)&&nw.origem==='cardapio')novoAvisoCaixa({html:`📲 <b>Novo pedido do cardápio nº ${esc(nw.num)}</b> — ${esc(nw.cliente||'')} · ${nw.tipo==='entrega'?'entrega':nw.tipo==='local'?'comer no local':'retirada'} · ${brl(totItens(nw.itens||[]))}`,abrir:id});
  if(GARCOM||col!=='mesas'||!nw)return;
  const po=(old&&old.pedidos)||[],pn=nw.pedidos||[];
  const novos=pn.filter(p=>!po.some(q=>q.id===p.id)&&p.dev!==DEV);
  novos.forEach(p=>novoAvisoCaixa({html:`🧑‍🍳 <b>${esc(rotulo(id))}</b> — ${esc(p.por)}: ${p.itens.map(i=>i.qtd+'x '+esc(i.nome)+(i.obs?' ('+esc(i.obs)+')':'')).join(', ')}${p.obs?` <i>(${esc(p.obs)})</i>`:''}`,abrir:id}));
  if(nw.conta&&!(old&&old.conta)&&nw.conta.dev!==DEV&&!novos.length&&lsGet('lg-printer','1')!=='1')novoAvisoCaixa({html:`🧾 <b>${esc(rotulo(id))}</b> — ${esc(nw.conta.por)} pediu a conta`,abrir:id});
});

/* =================== APP DO GARÇOM =================== */
const g={tela:'mesas',mesa:null,aba:'pedido',cat:null,pin:'',sel:null,carts:{},obs:'',imprimirCaixa:true};
try{g.carts=JSON.parse(lsGet('lg-carts','{}'))||{}}catch(e){}
const gUser=()=>(S.config.garcons||[]).find(x=>x.id===lsGet('lg-garcom'));
const cart=()=>g.carts[g.mesa]||(g.carts[g.mesa]={});
const saveCarts=()=>{lsSet('lg-carts',JSON.stringify(g.carts));lsSet('lg-cobs',JSON.stringify(g.cobs))};
g.cobs={};try{g.cobs=JSON.parse(lsGet('lg-cobs','{}'))||{}}catch(e){}
/* observação de cada item do pedido (ex.: hot roll — Doritos, cebolinha) */
const cobs=()=>g.cobs[g.mesa]||(g.cobs[g.mesa]={});
function gObs(pid){const p=S.produtos[kP(pid)];if(!p)return;const atual=cobs()[pid]||'',ops=String(p.obsDica||'').split(/[,;\n]/).map(x=>x.trim()).filter(Boolean);
  abrirModal(`<h2>📝 ${esc(p.nome)}</h2><p style="color:var(--mut);margin:0 0 8px">${p.pedeObs?'Escreva o que o cliente escolheu.':'Observação deste item para a cozinha.'}</p>
  ${ops.length?`<div class="gobs-ops">${ops.map(o=>`<button type="button" onclick="gObsAdd(this.textContent)">${esc(o)}</button>`).join('')}</div>`:''}
  <textarea id="gobsi" rows="3" maxlength="160" placeholder="${esc(ops.length?'Toque nas opções acima ou escreva aqui':'Ex.: sem cebola, molho à parte')}" style="width:100%;font-size:1.1rem">${esc(atual)}</textarea>
  <div class="row" style="margin-top:12px"><button class="btn big" style="flex:1" onclick="fecharModal()">Voltar</button><button class="btn ok big" style="flex:1.6" onclick="gObsSalvar('${pid}')">✅ Pronto</button></div>`);
  setTimeout(()=>{const t=$('#gobsi');if(t){t.focus();t.setSelectionRange(t.value.length,t.value.length)}},60)}
function gObsAdd(t){const el=$('#gobsi');if(!el)return;const v=el.value.trim();el.value=v?(v.replace(/[,\s]+$/,'')+', '+t):t;el.focus()}
function gObsSalvar(pid){const v=($('#gobsi')||{value:''}).value.trim().slice(0,160),o=cobs();if(v)o[pid]=v;else delete o[pid];saveCarts();fecharModal();render(true)}
/* cada linha do pedido tem uma chave: o id do produto, ou id~n quando é o mesmo produto com outra escolha */
const kP=k=>String(k).split('~')[0];
const cartItens=()=>Object.entries(cart()).filter(([k,q])=>q>0&&S.produtos[kP(k)]).map(([k,q])=>({k,p:S.produtos[kP(k)],q}));
const qPid=pid=>Object.entries(cart()).reduce((a,[k,q])=>a+(kP(k)===pid?q:0),0);
function gMenos(pid){const ks=Object.keys(cart()).filter(k=>kP(k)===pid&&cart()[k]>0);if(ks.length)gAdd(ks[ks.length-1],-1)}
function gVariante(pid){const k=pid+'~'+Date.now().toString(36);cart()[k]=1;saveCarts();render(true);gObs(k)}
function gGo(t,extra){Object.assign(g,{tela:t},extra||{});render(true);window.scrollTo(0,0)}
function gRender(){
  document.body.classList.add('gmode');
  const u=gUser();let h='';
  if(!u)return gLogin();
  h+=`<div class="gtop"><div class="logo" style="width:38px;height:38px">${S.config.logo?`<img src="${S.config.logo}">`:LOGO_SVG}</div><div style="flex:1;line-height:1.1"><b>GR ${ACG?'Açougue':'Restaurante'}</b><br><small>👤 ${esc(u.nome)}${mode==='api'?(online?' · 🟢 online':' · 🔴 sem conexão'):''}</small></div><button class="gbtn" style="white-space:nowrap" onclick="atualizarApp()" title="Atualizar o app">↻ Atualizar${novaVersao?' •':''}</button><button class="gbtn" onclick="confirmar('Sair do app?',()=>{lsSet('lg-garcom',null);render(true)})">Sair</button></div>`;
  /* trava: o app do garçom só funciona com o movimento aberto no caixa (abre sozinho quando o caixa abrir) */
  if(!movAberto())return h+`<div class="gtrava"><div class="gtrava-ic">🔒</div><h2>Aguardando o caixa</h2><p>O app libera sozinho assim que o caixa <b>abrir o movimento do dia</b>.<br>Não precisa fazer nada aqui.</p><div class="gtrava-pts"><span></span><span></span><span></span></div>${Object.values(g.carts||{}).some(c=>Object.values(c||{}).some(q=>q>0))?'<p style="margin-top:14px"><small>Os pedidos que você já começou continuam guardados.</small></p>':''}</div>`;
  if(g.tela==='mesas')h+=gMesas();
  else if(g.tela==='mesa')h+=gMesa();
  else if(g.tela==='carrinho')h+=gCarrinho();
  else if(g.tela==='fechar')h+=gFechar();
  return h;
}
function gLogin(){const gs=S.config.garcons||[];
  let h=`<div class="glogin"><div class="logo" style="width:84px;height:84px;margin:0 auto">${S.config.logo?`<img src="${S.config.logo}">`:LOGO_SVG.replace('width="34" height="34"','width="56" height="56"')}</div><h2 style="text-align:center;margin:12px 0 2px">GR Restaurante</h2><p style="text-align:center;color:var(--mut);margin:0 0 18px">App do Garçom</p>`;
  if(!gs.length)return h+`<div class="card vazio">Nenhum garçom cadastrado.<br>Peça ao caixa para cadastrar em <b>⚙️ Ajustes → Garçons</b>.</div></div>`;
  if(!g.sel)return h+`<b>Quem é você?</b><div class="gnomes">${gs.map(x=>`<button onclick="g.sel='${x.id}';g.pin='';render(true)">👤<br>${esc(x.nome)}</button>`).join('')}</div></div>`;
  const x=gs.find(y=>y.id===g.sel);
  return h+`<p style="text-align:center"><b>${esc(x?x.nome:'')}</b>, digite seu PIN</p><div class="pindots">${[0,1,2,3].map(i=>`<span class="${g.pin.length>i?'on':''}"></span>`).join('')}</div>
  <div class="pinpad">${[1,2,3,4,5,6,7,8,9,'←',0,'⌫'].map(k=>`<button onclick="gPin('${k}')">${k}</button>`).join('')}</div></div>`}
function gPin(k){if(k==='←'){g.sel=null;g.pin='';return render(true)}if(k==='⌫'){g.pin=g.pin.slice(0,-1);return render(true)}
  g.pin+=k;if(g.pin.length===4){const x=(S.config.garcons||[]).find(y=>y.id===g.sel);
    if(x&&x.pin===g.pin){lsSet('lg-garcom',x.id);g.pin='';g.sel=null;toast('Olá, '+x.nome+'! 👋')}else{g.pin='';toast('❌ PIN errado')}}
  render(true)}
function gMesas(){
  let h=`<div class="gpad"><h2 style="margin:6px 0 10px">Escolha a mesa</h2><div class="gmesas">`;
  for(let i=1;i<=NM();i++){const t=totMesa(i),m=mesa(i),c=Object.values(g.carts[String(i)]||{}).reduce((a,b)=>a+b,0);
    h+=`<button class="${t>0?'ocupada':''} ${m.conta?'conta':''}" onclick="gGo('mesa',{mesa:'${i}',aba:'pedido',cat:null})"><span class="ic">${t>0?MESA_OC:MESA_LIVRE}</span><b>${i}</b><small>${t>0?brl(t):'Livre'}</small>${m.conta?'<em>🧾 conta</em>':c?`<em>🛒 ${c}</em>`:''}</button>`}
  return h+'</div></div>'}
function gMesa(){
  const n=g.mesa,m=mesa(n),its=m.itens||[],tot=totItens(its);
  let h=`<div class="gbar"><button class="gbtn" onclick="gGo('mesas')">← Mesas</button><b style="flex:1;font-size:1.25rem">Mesa ${n}</b><span><small>Total</small><br><b>${brl(tot)}</b></span></div>
  <div class="gtabs"><button class="${g.aba==='pedido'?'act':''}" onclick="g.aba='pedido';render(true)">🍽️ Fazer pedido</button><button class="${g.aba==='conta'?'act':''}" onclick="g.aba='conta';render(true)">🧾 Conta ${tot?brl(tot):''}</button></div>`;
  if(g.aba==='conta')return h+gConta();
  const cats=CATS.filter(c=>prodList().some(p=>p.cat===c));
  if(!g.cat){h+=`<div class="gpad"><div class="gcats">${cats.map(c=>`<button onclick="g.cat='${c}';render(true)"><i>${CATIC[c]}</i>${c}<small>${prodList().filter(p=>p.cat===c).length} itens</small></button>`).join('')}</div>${!cats.length?'<div class="card vazio">Nenhum produto cadastrado no caixa.</div>':''}</div>`}
  else{h+=`<div class="gchips"><button onclick="g.cat=null;render(true)">☰ Menus</button>${cats.map(c=>`<button class="${g.cat===c?'act':''}" onclick="g.cat='${c}';render(true);window.scrollTo(0,0)">${CATIC[c]} ${c}</button>`).join('')}</div><div class="gpad">`;
    prodList().filter(p=>p.cat===g.cat).forEach(p=>{const q=qPid(p.id),d=disponivel(p)-q,obsL=Object.keys(cart()).filter(k=>kP(k)===p.id&&cart()[k]>0&&cobs()[k]).map(k=>cobs()[k]);
      h+=`<div class="gprod ${disponivel(p)<=0?'esg':''}"><div class="thumb">${p.img?`<img src="${p.img}">`:(CATIC[p.cat]||'🍽️')}</div><div class="nm"><b>${esc(p.nome)}</b><small>${p.codigo?'cód. '+p.codigo+(p.unidade?' · ':''):''}${esc(p.unidade||'')}</small><span class="pr">${brl(p.preco)}</span>${q&&obsL.length?`<span class="obs-it" onclick="gGo('carrinho')">📝 ${esc(obsL.join(' | '))}</span>`:p.pedeObs?`<small class="gpede">✏️ pede escolha${p.obsDica?': '+esc(p.obsDica):''}</small>`:''}${disponivel(p)<=0?'<small class="st-esg">⛔ Esgotado</small>':d!==Infinity&&d<=estMin(p)?`<small class="low">⚠️ restam ${Math.max(0,d)}</small>`:''}</div>
      <div class="gqty">${q?`<button onclick="gMenos('${p.id}')">−</button><span>${q}</span>`:''}<button class="mais" onclick="gAdd('${p.id}',1)">+</button></div></div>`});
    h+='</div>'}
  const ci=cartItens();
  if(ci.length)h+=`<div class="gcart" onclick="gGo('carrinho')"><span>🛒 <b>${ci.reduce((a,x)=>a+x.q,0)} itens</b> · ${brl(ci.reduce((a,x)=>a+x.q*x.p.preco,0))}</span><b>Ver e enviar ▸</b></div>`;
  return h}
function gAdd(pid,d){const c=cart(),p=S.produtos[kP(pid)];if(!p)return;
  if(d>0&&disponivel(p)-qPid(p.id)<=0)return toast(`${p.nome} sem estoque`);
  c[pid]=Math.max(0,(c[pid]||0)+d);if(!c[pid]){delete c[pid];delete cobs()[pid]}saveCarts();render(true);
  if(d>0&&p.pedeObs&&!cobs()[pid])gObs(pid)}
function gCarrinho(){const ci=cartItens(),t=ci.reduce((a,x)=>a+x.q*x.p.preco,0);
  let h=`<div class="gbar"><button class="gbtn" onclick="gGo('mesa')">← Continuar</button><b style="flex:1;font-size:1.15rem">Pedido — Mesa ${g.mesa}</b></div><div class="gpad">`;
  if(!ci.length)return h+`<div class="card vazio">Nenhum item escolhido.</div></div>`;
  ci.forEach(({k,p,q})=>{const ob=cobs()[k]||'';h+=`<div class="gprod"><div class="thumb">${p.img?`<img src="${p.img}">`:(CATIC[p.cat]||'🍽️')}</div><div class="nm"><b>${esc(p.nome)}</b><small>${brl(p.preco)} cada</small><span class="pr">${brl(p.preco*q)}</span>
    ${ob?`<span class="obs-it" onclick="gObs('${k}')">📝 ${esc(ob)} <u>trocar</u></span>`:p.pedeObs?`<button class="gobs-bt falta" onclick="gObs('${k}')">⚠️ Falta escrever a escolha</button>`:`<button class="gobs-bt" onclick="gObs('${k}')">✏️ Observação</button>`}${ob||p.pedeObs?`<button class="gobs-bt" onclick="gVariante('${p.id}')">➕ Mais um com outra escolha</button>`:''}</div><div class="gqty"><button onclick="gAdd('${k}',-1)">−</button><span>${q}</span><button class="mais" onclick="gAdd('${k}',1)">+</button></div></div>`});
  h+=`<div class="total"><span>Total do pedido</span><span>${brl(t)}</span></div>
  <label>📝 Observação geral do pedido</label><input id="gobs" value="${esc(g.obs)}" oninput="g.obs=this.value" placeholder="Ex.: servir tudo junto">
  <button class="btn ok big" style="margin-top:14px" onclick="gEnviar()">📤 Enviar pedido para o caixa</button>
  <button class="btn big" style="margin-top:8px" onclick="g.carts[g.mesa]={};g.cobs[g.mesa]={};saveCarts();gGo('mesa')">🗑️ Limpar pedido</button></div>`;
  return h}
async function gEnviar(){
  if(!movAberto())return toast('O caixa ainda não abriu o movimento.');
  const u=gUser(),n=g.mesa,ci=cartItens();if(!ci.length)return;
  for(const {p} of ci){const q=qPid(p.id);if(disponivel(p)<q)return toast(`⛔ ${p.nome}: só tem ${Math.max(0,disponivel(p))} no estoque`)}
  const ob=cobs(),falta=ci.find(({k,p})=>p.pedeObs&&!ob[k]);if(falta){toast(`✏️ Escreva a escolha do ${falta.p.nome}`);return gObs(falta.k)}
  await mutate('estado','atual',e=>({...(e||{}),seq:((e&&e.seq)||0)+1}));const num=(S.estado&&S.estado.seq)||'';
  const ped={id:uid(),num,por:u.nome,dev:DEV,hora:new Date().toISOString(),itens:ci.map(({k,p,q})=>({nome:nomeP(p),qtd:q,...(ob[k]?{obs:ob[k]}:{})})),obs:g.obs.trim()};
  const ok=await mutate('mesas',n,m=>{for(const {k,p,q} of ci)m=addNaComanda(m,p.id,q,u.nome,ob[k]);m.pedidos=[...(m.pedidos||[]),ped].slice(-40);return m});
  if(!ok)return toast('Não foi possível enviar. Tente de novo.');
  g.carts[n]={};g.cobs[n]={};g.obs='';saveCarts();toast('✅ Pedido nº '+num+' enviado para o caixa!');alertaEstoque(ci.map(x=>x.p.id));gGo('mesa',{aba:'conta',cat:null});
  gPerguntarImpressao(n,ped,u)}
let gUltPed=null;
function gPerguntarImpressao(n,ped,u){gUltPed={n,ped,u};
  abrirModal(`<div style="text-align:center"><div class="hic" style="width:64px;height:64px;border-radius:18px;margin:0 auto 12px;display:grid"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 9V3.5h10V9"/><rect x="3.5" y="9" width="17" height="8" rx="2"/><path d="M7 14h10v6.5H7z"/></svg></div>
  <h2 style="justify-content:center">Imprimir este pedido?</h2><p style="color:var(--mut)">O pedido já está lançado na Mesa ${n}. Imprimir manda o papel para a cozinha (na impressora do caixa).</p>
  <div class="row" style="margin-top:14px"><button class="btn big" style="flex:1" onclick="fecharModal()">Não</button><button class="btn ok big" style="flex:1.4" onclick="gImprimirPedido()">🖨️ Sim, imprimir</button></div></div>`)}
async function gImprimirPedido(){const x=gUltPed;fecharModal();if(!x)return;
  const num=x.ped.num||'';
  await put('fila',uid(),{tipo:'pedido',rotulo:'Pedido nº '+num+' — Mesa '+x.n,por:x.u.nome,html:ticketPedido({num,mesa:x.n,itens:x.ped.itens,obs:x.ped.obs,por:x.u.nome,hora:x.ped.hora}),ts:Date.now()});
  toast('🖨️ Pedido nº '+num+' enviado para imprimir')}
function gConta(){const n=g.mesa,m=mesa(n),its=m.itens||[],tot=totItens(its);
  let h=`<div class="gpad">`;
  if(!its.length)return h+`<div class="card vazio">Mesa sem consumo ainda.</div></div>`;
  h+=`<div class="card">${its.map(i=>`<div class="it"><div class="nm"><b>${i.qtd}x ${esc(i.nome)}</b>${i.obs?`<span class="obs-it">📝 ${esc(i.obs)}</span>`:''}<small>${brl(i.preco)} cada</small></div><div class="sub">${brl(vIt(i))}</div></div>`).join('')}
  <div class="total"><span>Total</span><span>${brl(tot)}</span></div></div>
  ${m.conta?`<div class="aviso" style="margin-top:10px">🧾 Conta pedida por ${esc(m.conta.por)} às ${hr(m.conta.hora)}.</div>`:''}
  <button class="btn pri big" style="margin-top:12px" onclick="gPedirConta()">🖨️ Pedir conta — imprime no caixa</button>
  <button class="btn acc big" style="margin-top:8px" onclick="st.pag=null;st.cpf='';st.nota=false;gGo('fechar')">💳 Fechar pelo app (maquininha)</button>
  ${(m.pedidos||[]).length?`<h3 style="margin-top:18px">Pedidos enviados</h3>${m.pedidos.slice().reverse().map(p=>`<div class="pedlog"><b>${hr(p.hora)} · ${esc(p.por)}</b> — ${p.itens.map(i=>i.qtd+'x '+esc(i.nome)+(i.obs?` <span class="obs-it">📝 ${esc(i.obs)}</span>`:'')).join(', ')}${p.obs?`<br><i>📝 ${esc(p.obs)}</i>`:''}</div>`).join('')}`:''}</div>`;
  return h}
function resumoHtml(n,titulo){const its=mesa(n).itens||[],pg=mesa(n).pagos||[];return `<div class="cupom">${cupomCab()}<hr><div class="c tk-n">${titulo||'FECHAMENTO DE CONTA'}</div>${isDel(n)&&mesa(n).tipo!=='local'?'<div class="c tk-v">PARA VIAGEM</div>':''}<div class="c">${esc(rotulo(n))} · ${dt(new Date().toISOString())}${mesa(n).garcom?'<br>Garçom: '+esc(mesa(n).garcom):''}</div><hr>${tabelaItens(its)}${pg.length?`<hr><div class="c">JÁ PAGO</div><table>${pg.map(i=>`<tr><td><s>${fq(i)} ${esc(i.nome)}</s></td><td class="n"><s>${brl(vIt(i))}</s></td></tr>`).join('')}<tr><td>Total já pago</td><td class="n">${brl(totItens(pg))}</td></tr></table>`:''}<hr>
  <table><tr><td>Itens</td><td class="n">${its.reduce((s,i)=>s+i.qtd,0)}</td></tr><tr><td><b>${pg.length?'FALTA PAGAR':'TOTAL'}</b></td><td class="n"><b>${brl(totItens(its))}</b></td></tr></table><hr><div class="c">NÃO É DOCUMENTO FISCAL<br>Confira antes de pagar</div></div>`}
async function gPedirConta(){const u=gUser(),n=g.mesa;
  await mutate('mesas',n,m=>m?{...m,conta:{por:u.nome,dev:DEV,hora:new Date().toISOString()}}:ABORT);
  await put('fila',uid(),{tipo:'conta',rotulo:rotulo(n),por:u.nome,html:resumoHtml(n),ts:Date.now()});
  toast('🖨️ Conta enviada para imprimir no caixa');render(true)}
function gFechar(){const n=g.mesa,its=mesa(n).itens||[],tot=totItens(its);
  return `<div class="gbar"><button class="gbtn" onclick="gGo('mesa',{aba:'conta'})">← Voltar</button><b style="flex:1;font-size:1.15rem">Fechar Mesa ${n}</b></div><div class="gpad">
  <div class="totalBig">${brl(tot)}</div><b>Forma de pagamento</b>
  <div class="pags">${PAGS.map(([p,i])=>`<button class="${st.pag===p?'act':''}" onclick="st.pag='${p}';render(true)"><i>${i}</i>${p}</button>`).join('')}</div>
  ${st.pag==='Dinheiro'?blocoTroco(tot):''}${blocoCPF()}
  <label class="chk"><input type="checkbox" ${g.imprimirCaixa?'checked':''} onchange="g.imprimirCaixa=this.checked"><span>Imprimir o recibo no caixa</span></label>
  <button class="btn ok big" style="margin-top:12px" ${st.pag?'':'disabled'} onclick="gFinalizar()">✅ Pagamento aprovado — Finalizar</button></div>`}
async function gFinalizar(){const u=gUser(),n=g.mesa;
  const v=await fecharComanda(n,{pag:st.pag,cpf:st.cpf,nota:st.nota,por:u.nome});if(!v)return;
  if(g.imprimirCaixa)put('fila',uid(),{tipo:'recibo',rotulo:v.rotulo,por:u.nome,html:cupomVenda(v),ts:Date.now()});
  g.carts[n]={};saveCarts();gGo('mesas');
  abrirModal(`<div style="text-align:center"><div style="font-size:3.5rem">✅</div><h2>Mesa ${n} fechada!</h2><p>${esc(v.pagamento)} · <b>${brl(v.total)}</b>${v.cpf?'<br>CPF na nota: '+v.cpf:''}</p>${g.imprimirCaixa?'<p>🖨️ O recibo vai sair na impressora do caixa.</p>':''}<button class="btn pri big" onclick="fecharModal()">OK</button></div>`)}

/* ---------- modal ---------- */
let modalTipo=null;
function abrirModal(h,tipo){modalTipo=tipo||null;$('#modal').classList.remove('largo');$('#modal').innerHTML=h;lgEnfeitar($('#modal'));$('#modalBg').classList.remove('hidden')}
function fecharModal(){modalTipo=null;$('#modalBg').classList.add('hidden');$('#modal').innerHTML=''}
/* fecha clicando fora só se o clique COMEÇOU fora (arrastar a barra de rolagem ou selecionar texto não fecha)
   e nunca fecha assim um formulário (cadastro de produto, cliente...): aí só pelo Cancelar/Salvar ou Esc */
let mdAlvo=null;$('#modalBg').addEventListener('pointerdown',e=>{mdAlvo=e.target});
$('#modalBg').addEventListener('click',e=>{const fora=e.target.id==='modalBg'&&mdAlvo&&mdAlvo.id==='modalBg';mdAlvo=null;
  if(fora&&!$('#modal').querySelector('input:not([type=hidden]):not([readonly]),textarea,select'))fecharModal()});
let _cb=null;
function confirmar(msg,cb){_cb=cb;abrirModal(`<p style="font-size:1.1rem">${msg}</p><div class="row"><button class="btn" style="flex:1" onclick="fecharModal()">Cancelar</button><button class="btn pri" style="flex:1" onclick="const f=_cb;fecharModal();f&&f()">Confirmar</button></div>`)}

iniciar();
</script>
<script>/* GR: brilho de "dados passando" pelo logo (logo sem fundo) */
(function(){if(window.grFx)return;var css=document.createElement('style');
css.textContent='.grfx{position:relative}.grfx-w{display:inline-flex;vertical-align:middle;position:relative;line-height:0}'+
'.grfx::after,.grfx-w::after{content:"";position:absolute;inset:0;pointer-events:none;-webkit-mask:var(--m) center/contain no-repeat;mask:var(--m) center/contain no-repeat;'+
'background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.0) 40%,rgba(210,255,250,.95) 49%,rgba(120,170,255,.9) 52%,transparent 62%) no-repeat;background-size:260% 100%;'+
'animation:grfx 2.6s cubic-bezier(.45,.05,.3,1) infinite;mix-blend-mode:screen}'+
'.grfx.lento::after,.grfx-w.lento::after{animation-duration:7s}'+
'@keyframes grfx{0%{background-position:140% 0}55%,100%{background-position:-40% 0}}'+
'@media (prefers-reduced-motion:reduce){.grfx::after,.grfx-w::after{animation:none;opacity:0}}';
(document.head||document.documentElement).appendChild(css);
var SEL='img.lg-pilar,img[src*="gr-emblema"],img[src*="logo-gr"],img.gr-logo';
function fx(){document.querySelectorAll(SEL).forEach(function(i){if(!i.src)return;if(i.dataset.grfx){if(i.dataset.grfx!==i.src){i.dataset.grfx=i.src;var w=i.closest('.grfx,.grfx-w');if(w)w.style.setProperty('--m','url("'+i.src+'")')}return}i.dataset.grfx=i.src;var p=i.parentElement,alvo;
  var lento=!!i.closest('header,nav,.nav,.marca,.brand');
  if(p&&p.children.length===1&&!/^(A|BUTTON|BODY)$/.test(p.tagName)){alvo=p;p.classList.add('grfx')}else{alvo=document.createElement('span');alvo.className='grfx-w';p.insertBefore(alvo,i);alvo.appendChild(i)}
  if(lento)alvo.classList.add('lento');alvo.style.setProperty('--m','url("'+i.src+'")')})}
window.grFx=fx;fx();if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',fx);
var ag=0;new MutationObserver(function(){if(!ag){ag=1;requestAnimationFrame(function(){ag=0;fx()})}}).observe(document.documentElement,{childList:true,subtree:true,attributes:true,attributeFilter:['src']})})();</script>
<script>/* telefone no padrão (17) 99999-9999 em todo campo de telefone */
(function(){function f(v){var d=String(v||'').replace(/\D/g,'');if(d.length>11&&d.slice(0,2)==='55')d=d.slice(2);d=d.slice(0,11);if(!d)return '';
if(d.length<=2)return '('+d;var a='('+d.slice(0,2)+') ',r=d.slice(2);if(r.length<=4)return a+r;var c=d.length===11?5:4;return a+r.slice(0,c)+'-'+r.slice(c)}
window.lgFone=f;document.addEventListener('input',function(e){var t=e.target;if(!t||t.tagName!=='INPUT'||!(t.inputMode==='tel'||t.type==='tel'))return;
if(e.inputType&&e.inputType.indexOf('delete')===0)return;var n=f(t.value);if(n!==t.value){t.value=n;try{t.setSelectionRange(n.length,n.length)}catch(x){}}},true);})();</script>
<script>
/* "Mostrar senha": olho em todo campo de senha (Central, Rural, E-mails, Câmara, caixa) */
