  const npn=notasPend().length;st.hNota=st.hNota||'';
  if(st.hNota==='pendente')vs=vs.filter(v=>v.nota&&v.nota.status==='pendente');
  if(st.hNota==='emitida')vs=vs.filter(v=>v.nota&&v.nota.status==='emitida');
  if(st.hNota==='cpf')vs=vs.filter(v=>v.cpf);
  let h=`<div class="row" style="margin-bottom:6px"><h2 style="margin:0;flex:1">📜 Histórico de ${ACG?'vendas':'mesas'}</h2>
  <select style="width:auto" onchange="st.hMesa=this.value;st.pg_hist=0;render(true)"><option value="">Todas as mesas</option><option value="d" ${st.hMesa==='d'?'selected':''}>🛵 Retirada/Delivery</option><option value="balcao" ${st.hMesa==='balcao'?'selected':''}>Venda no balcão</option>${Array.from({length:NM()},(_,i)=>`<option ${st.hMesa==String(i+1)?'selected':''} value="${i+1}">Mesa ${i+1}</option>`).join('')}</select></div>
  <div class="chips">${[['','Todas as vendas'],['pendente',`🧾 Notas a emitir (${npn})`],['emitida','✅ Notas emitidas'],['cpf','🪪 Com CPF']].map(([k,t])=>`<button class="chip ${st.hNota===k?'act':''}" onclick="st.hNota='${k}';st.pg_hist=0;render(true)">${t}</button>`).join('')}</div>`;
  if(!vs.length)return h+`<div class="card vazio">${st.hNota==='pendente'?'✅ Nenhuma nota pendente.':'Nenhuma venda encontrada.'}</div>`;
  const PG=pagina('hist',vs,15);
  h+='<div class="hist" data-pgk="hist">';
