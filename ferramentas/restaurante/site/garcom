function cicloCli(c,ref){const d=Math.min(28,Math.max(1,+c.diaFecha||1)),h=ref?new Date(ref):new Date();
  let ini=new Date(h.getFullYear(),h.getMonth(),d);if(ini>h)ini=new Date(h.getFullYear(),h.getMonth()-1,d);
  const fim=new Date(ini.getFullYear(),ini.getMonth()+1,d),dias=Math.max(0,Math.ceil((fim-h)/864e5));return {ini,fim,dias}}
const vendasConta=c=>Object.values(S.vendas||{}).filter(v=>v.cliId===c.id&&v.pagamento===CONTA);
function usoCli(c){const {ini,fim,dias}=cicloCli(c),vs=vendasConta(c);
  const usado=vs.filter(v=>{const t=new Date(v.data);return t>=ini&&t<fim}).reduce((s,v)=>s+v.total,0);
  const pago=(c.pagamentos||[]).reduce((s,p)=>s+(+p.valor||0),0),devendo=vs.reduce((s,v)=>s+v.total,0)-pago;
  const lim=+c.limite||0;return {lim,usado:r2(usado),disp:lim?r2(lim-usado):Infinity,dias,ini,fim,devendo:r2(devendo)}}
