  a.classList.remove('hidden');clearTimeout(a._h);a.onclick=null}
function imprimirAviso(i){const x=avisosCaixa[i];avisosCaixa.splice(i,1);mostrarAvisosCaixa();imprimir(x.print,x.nome)}
