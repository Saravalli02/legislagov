const kg3=x=>(+x||0).toLocaleString('pt-BR',{minimumFractionDigits:3,maximumFractionDigits:3});
const fmtQ=q=>Number.isInteger(+q)?String(+q):kg3(q);
const ehKg=p=>!!(p&&p.porKg);
const unP=p=>ehKg(p)?'kg':'un';
const rq=(p,x)=>ehKg(p)?Math.round((+x||0)*1000)/1000:Math.round(+x||0);
const r2=x=>Math.round((+x||0)*100)/100;
/* "1,250" = 1,250 kg · "350g" ou "350" = 350 gramas · "1kg" = 1 kg */
function lerPeso(t){t=String(t||'').trim().toLowerCase().replace(/\s/g,'');if(!t)return 0;
  if(/kg$/.test(t))return num(t.replace(/kg$/,''));
  if(/g$/.test(t))return num(t.replace(/g$/,''))/1000;
  const n=num(t);return /[.,]/.test(t)?n:(n>=30?n/1000:n)}
const balCfg=()=>({prefixo:'2',digitos:5,traz:'preco',...((S.config||{}).balanca||{})});
/* etiqueta da balança (EAN-13 começando com o prefixo): 2 + código do produto + valor (preço total ou peso) + dígito verificador */
function lerEtiqueta(t){t=soDig(t);const c=balCfg();if(t.length!==13||!t.startsWith(String(c.prefixo||'2')))return null;
  const nd=Math.min(6,Math.max(4,+c.digitos||5)),cod=t.slice(1,1+nd),val=t.slice(1+nd,12);
  const ps=Object.values(S.produtos);
  const p=ps.find(x=>x.plu&&String(+x.plu)===String(+cod))||ps.find(x=>String(x.codigo||'')===String(+cod));
  if(!p)return {erro:`Etiqueta da balança: produto de código ${+cod} não cadastrado. Confira o código da balança em Produtos.`};
  const v=+val;
  if(c.traz==='peso'){const q=v/1000;return {p,qtd:q,tot:r2(q*p.preco)}}
  const tot=v/100,q=p.preco>0?Math.round(tot/p.preco*1000)/1000:1;return {p,qtd:q,tot}}
