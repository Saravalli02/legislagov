function f8(){
  if(modalTipo==='venda'){if(st.pag)finalizar();else toast('Escolha o pagamento: '+Object.entries(PAGK).map(([p,k])=>k+' = '+p).join(' · '));return}
  if(emPdv()){if(nLin())receberBalcao();else toast('Lance pelo menos um produto.');return}
  if(view==='mesa'&&(mesa(curMesa).itens||[]).length){fecharModal();fecharVenda()}
  else if(view==='mesas'&&(mesa(BAL).itens||[]).length)receberBalcao()
  else toast('Abra uma mesa com consumo para fechar a venda (F8).')}
let scan='',scanT=0;
document.addEventListener('keydown',e=>{
  if(GARCOM)return;
  const k=e.key,aberto=!$('#modalBg').classList.contains('hidden');
  const F={F1:ajuda,F2:()=>{fecharModal();go('mesas')},F3:()=>{fecharModal();go('produtos')},F4:()=>{fecharModal();go('estoque')},F6:()=>{fecharModal();go('historico')},F7:()=>{fecharModal();go('relatorios')},F8:f8,F9:()=>{if(emPdv()&&!aberto)pdvRecuperar();else reimprimirUltimo()},
    F10:()=>{if(emPdv()){if(modalTipo==='venda'||!aberto)pdvGuardar();return}if(view==='mesa'&&(mesa(curMesa).itens||[]).length)imprimirConta(modalTipo==='venda'?'modalVenda()':null)}};
  if(F[k]){e.preventDefault();F[k]();return}
  if(k==='Escape'){if(!$('#alerta').classList.contains('hidden'))$('#alerta').classList.add('hidden');if(aberto)fecharModal();else if(view==='mesa')go('mesas');return}
  if(aberto&&modalTipo==='venda'){if(document.activeElement&&document.activeElement.tagName==='INPUT'&&document.activeElement.type!=='checkbox'){if(k==='Enter'&&st.pag){e.preventDefault();finalizar()}return}const p=Object.keys(PAGK).find(x=>PAGK[x].toLowerCase()===k.toLowerCase());
    if(p){e.preventDefault();st.pag=p;modalVenda()}else if(k==='Enter'&&st.pag){e.preventDefault();finalizar()}return}
  // leitor de código de barras: números chegando muito rápido + Enter (fora de qualquer campo)
  if(!aberto&&!digitando()&&((view==='mesas'&&!emPdv())||view==='mesa')){const agora=Date.now();
    if(/^\d$/.test(k)){scan=(agora-scanT<60?scan:'')+k;scanT=agora}
    else if(k==='Enter'&&scan.length>=6&&agora-scanT<120){e.preventDefault();const c=scan;scan='';numBuf='';
      const p=acharProduto(c);if(!p){toast(`Código de barras ${c} não cadastrado. Cadastre em Produtos.`);return}
      if(view==='mesa')lancarEm(curMesa,p.id);else{lancarEm(BAL,p.id);balRedesenhar(false)}return}}
  if(emPdv()&&!aberto){
    if(k==='F5'){e.preventDefault();pdvDescontoVenda();return}
    if(k==='Insert'){e.preventDefault();pdvValor();return}
    if(k==='Delete'&&!(document.activeElement&&document.activeElement.value)){e.preventDefault();pdvExcluirUltimo();return}
    if(!digitando()&&k.length===1){const q=$('#pdq');if(q)q.focus()}}
  if(view==='mesa'&&!aberto&&!digitando()&&/^\d$/.test(k)){const f=$('#view [data-focus]');if(f){f.focus()}}
  if(view==='mesas'&&!emPdv()&&!aberto&&!digitando()){
    if(/^\d$/.test(k)){numBuf=(numBuf+k).slice(-2);if(scan.length<3)toast(`Mesa ${numBuf} — aperte Enter para abrir`)}
    else if(k==='Enter'&&numBuf){const n=+numBuf;numBuf='';if(n>=1&&n<=NM())abrirMesa(n);else toast('Mesa inválida (1 a '+NM()+')')}
    else if(k==='Backspace'){numBuf=numBuf.slice(0,-1)}}
});

